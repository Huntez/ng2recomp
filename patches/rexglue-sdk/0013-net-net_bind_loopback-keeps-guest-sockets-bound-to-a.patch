From c5ba5a94455610524dffac795dbec50f4237dd5c Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Mon, 2 Nov 2026 21:09:35 +0000
Subject: [PATCH] net: net_bind_loopback keeps guest sockets bound to any
 address on loopback

---
 src/system/xsocket.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/system/xsocket.cpp b/src/system/xsocket.cpp
index 2d13ac8..c4a0a7e 100644
--- a/src/system/xsocket.cpp
+++ b/src/system/xsocket.cpp
@@ -11,6 +11,7 @@
 
 #include <cstring>
 
+#include <rex/cvar.h>
 #include <rex/kernel/xam/module.h>
 #include <rex/platform.h>
 #include <rex/system/kernel_state.h>
@@ -31,6 +32,10 @@
 #include <sys/socket.h>
 #endif
 
+REXCVAR_DEFINE_BOOL(net_bind_loopback, false, "Network",
+                    "Guest sockets bound to any address take the loopback address: nothing "
+                    "listens on the network (no LAN play, no firewall prompt)");
+
 namespace rex::system {
 
 XSocket::XSocket(KernelState* kernel_state) : XObject(kernel_state, kObjectType) {}
@@ -110,6 +115,10 @@ X_STATUS XSocket::Connect(N_XSOCKADDR* name, int name_len) {
 }
 
 X_STATUS XSocket::Bind(N_XSOCKADDR_IN* name, int name_len) {
+  if (REXCVAR_GET(net_bind_loopback) && name->sin_family == X_AF_INET &&
+      name->sin_addr == 0u) {
+    name->sin_addr = 0x7F000001u;  // 127.0.0.1
+  }
   int ret = bind(native_handle_, (sockaddr*)name, name_len);
   if (ret < 0) {
     return X_STATUS_UNSUCCESSFUL;
-- 
