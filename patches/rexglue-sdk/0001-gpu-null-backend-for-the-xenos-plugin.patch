From 55ded39b7e7aa9b7ff2aa7bdc81249040db377db Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 14:55:42 +0000
Subject: [PATCH] gpu: null backend for the xenos plugin

LoadGpuPlugin("xenos", "null") gives a graphics system whose command
processor runs the guest command stream (fences, interrupts, vblank, swap
packets) without rendering, for titles drawn by a host renderer from hooked
graphics API calls. Modelled on Xenia's former null backend.
---
 src/graphics/CMakeLists.txt           |  1 +
 src/graphics/null/graphics_system.cpp | 59 +++++++++++++++++++++++++++
 src/graphics/plugin_main.cpp          |  8 ++++
 3 files changed, 68 insertions(+)
 create mode 100644 src/graphics/null/graphics_system.cpp

diff --git a/src/graphics/CMakeLists.txt b/src/graphics/CMakeLists.txt
index 0d8f8af..68f9591 100644
--- a/src/graphics/CMakeLists.txt
+++ b/src/graphics/CMakeLists.txt
@@ -28,6 +28,7 @@ set(REXGPU_XENOS_SOURCES
     pipeline/shader/interpreter.cpp
     pipeline/shader/translator.cpp
     pipeline/shader/translator_disasm.cpp
+    null/graphics_system.cpp
 )
 
 # SPIR-V shader translation
diff --git a/src/graphics/null/graphics_system.cpp b/src/graphics/null/graphics_system.cpp
new file mode 100644
index 0000000..237310d
--- /dev/null
+++ b/src/graphics/null/graphics_system.cpp
@@ -0,0 +1,59 @@
+/**
+ * @file        graphics/null/graphics_system.cpp
+ * @brief       Null GPU backend: processes the guest command stream (fences,
+ *              interrupts, vblank, swaps) without rendering anything.
+ *
+ * For titles whose host renderer draws from hooked graphics API calls: the
+ * guest's own graphics library keeps running unmodified against a GPU that
+ * retires its work at once. Modelled on Xenia's former null backend.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <memory>
+#include <string>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+
+namespace rex::graphics::null {
+
+class NullCommandProcessor : public CommandProcessor {
+ public:
+  using CommandProcessor::CommandProcessor;
+
+  void IssueSwap(uint32_t, uint32_t, uint32_t) override {}
+
+ protected:
+  bool SetupContext() override { return true; }
+  void ShutdownContext() override {}
+
+  Shader* LoadShader(xenos::ShaderType, uint32_t, const uint32_t*, uint32_t) override {
+    return nullptr;
+  }
+
+  bool IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) override { return true; }
+  bool IssueCopy() override { return true; }
+};
+
+class NullGraphicsSystem : public GraphicsSystem {
+ public:
+  std::string name() const override { return "null"; }
+
+  // The host renderer owns the window and presents; nothing to set up here.
+  X_STATUS SetupPresentation(ui::WindowedAppContext*) override { return X_STATUS_SUCCESS; }
+
+ protected:
+  void CreateProvider(bool) override {}
+
+ private:
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override {
+    return std::make_unique<NullCommandProcessor>(this, kernel_state_);
+  }
+};
+
+system::IGraphicsSystem* CreateNullGraphicsSystem() {
+  return new NullGraphicsSystem();
+}
+
+}  // namespace rex::graphics::null
diff --git a/src/graphics/plugin_main.cpp b/src/graphics/plugin_main.cpp
index ec756d3..298c7c0 100644
--- a/src/graphics/plugin_main.cpp
+++ b/src/graphics/plugin_main.cpp
@@ -21,6 +21,10 @@
 #include <rex/graphics/vulkan/graphics_system.h>
 #endif
 
+namespace rex::graphics::null {
+system::IGraphicsSystem* CreateNullGraphicsSystem();
+}
+
 extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
   return rex::system::kGpuPluginAbiVersion;
 }
@@ -38,6 +42,10 @@ extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
   }
 
   std::string_view backend = info->backend ? info->backend : "any";
+  // Only on request: processes the command stream without rendering.
+  if (backend == "null") {
+    return rex::graphics::null::CreateNullGraphicsSystem();
+  }
 #if REX_HAS_D3D12
   if (backend == "any" || backend == "d3d12") {
     return new rex::graphics::d3d12::D3D12GraphicsSystem();
-- 
