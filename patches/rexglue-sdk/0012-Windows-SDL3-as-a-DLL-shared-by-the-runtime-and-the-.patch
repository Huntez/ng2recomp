From b0f3154bd8ff06399297bbdd680ae25c0236f217 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Mon, 2 Nov 2026 20:32:00 +0000
Subject: [PATCH] Windows: SDL3 as a DLL shared by the runtime and the app

Linked statically into both rexruntime.dll and the app, each had its own
SDL (the app's saw no windows): Windows doesn't merge the copies as ELF
loading does.
---
 thirdparty/CMakeLists.txt | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index d8ef77c..ca0c3d7 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -245,8 +245,16 @@ target_compile_options(imgui PRIVATE -w)
 # SDL3 - Cross-platform media layer
 #=============================================================================
 set(SDL_INSTALL ON CACHE BOOL "" FORCE)
-set(SDL_SHARED OFF CACHE BOOL "" FORCE)
-set(SDL_STATIC ON CACHE BOOL "" FORCE)
+# Windows: one SDL3.dll for the runtime and the app. Linked statically into
+# both, each would have its own SDL (its own windows, events and audio):
+# Windows doesn't merge them as ELF loading does.
+if(WIN32)
+    set(SDL_SHARED ON CACHE BOOL "" FORCE)
+    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
+else()
+    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+    set(SDL_STATIC ON CACHE BOOL "" FORCE)
+endif()
 set(SDL_TEST OFF CACHE BOOL "" FORCE)
 set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
 
-- 
2.56.0

