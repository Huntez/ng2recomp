From 1f54a6cd9809e61e1fb63d819517391a189ef47c Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 29 Oct 2026 01:48:11 +0000
Subject: [PATCH] gpu: no pending commands after the ring buffer is replaced

A title can call VdInitializeRingBuffer again while the command processor
runs (Ninja Gaiden II does after its intro movie, resetting its device).
InitializeRingBuffer reset the read pointer but kept the old write pointer,
so a worker waking up before the title's first write pointer update ran
the new ring's stale memory from 0 to the old write pointer, failed on a
bad packet and left the title waiting on its fences forever.

Park the write pointer at the worker's existing 'nothing written' value
instead, and count ring generations under a mutex so a worker that was
mid-way through the old ring drops the read pointer it computed for it
rather than overwriting the new ring's.
---
 include/rex/graphics/command_processor.h |  4 ++++
 src/graphics/command_processor.cpp       | 25 ++++++++++++++++++++++--
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index da8e432..10e481e 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -254,6 +254,10 @@ class CommandProcessor {
 
   std::unique_ptr<rex::thread::Event> write_ptr_index_event_;
   std::atomic<uint32_t> write_ptr_index_;
+  // Bumped when the title replaces the ring; the worker drops a read pointer
+  // it computed for the previous ring. ring_mutex_ orders the two.
+  std::mutex ring_mutex_;
+  uint32_t ring_generation_ = 0;
 
   // Some titles submit writes beyond the emulated register file range in PM4
   // packets. Preserve these values so dependent packet logic can still observe
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..128dd61 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -236,11 +236,25 @@ void CommandProcessor::WorkerThreadMain() {
         continue;
       }
     }
-    assert_true(read_ptr_index_ != write_ptr_index);
+    uint32_t read_ptr_index, generation;
+    {
+      std::lock_guard lock(ring_mutex_);
+      read_ptr_index = read_ptr_index_;
+      generation = ring_generation_;
+      write_ptr_index = write_ptr_index_.load();
+    }
+    if (write_ptr_index == 0xBAADF00D || read_ptr_index == write_ptr_index) {
+      continue;  // the ring was replaced since the check above
+    }
 
     // Execute. Note that we handle wraparound transparently.
-    read_ptr_index_ = ExecutePrimaryBuffer(read_ptr_index_, write_ptr_index);
+    uint32_t new_read_ptr_index = ExecutePrimaryBuffer(read_ptr_index, write_ptr_index);
 
+    std::lock_guard lock(ring_mutex_);
+    if (generation != ring_generation_) {
+      continue;  // the title replaced the ring meanwhile: this position is stale
+    }
+    read_ptr_index_ = new_read_ptr_index;
     // TODO(benvanik): use reader->Read_update_freq_ and only issue after moving
     //     that many indices.
     if (read_ptr_writeback_ptr_) {
@@ -312,9 +326,16 @@ bool CommandProcessor::SetupContext() {
 void CommandProcessor::ShutdownContext() {}
 
 void CommandProcessor::InitializeRingBuffer(uint32_t ptr, uint32_t size_log2) {
+  // A title can replace the ring while the worker runs (after a device
+  // reset). Until the title writes the new ring's write pointer, nothing is
+  // pending: with the old write pointer left in place the worker would run
+  // whatever memory the new ring holds from 0 up to it.
+  std::lock_guard lock(ring_mutex_);
+  write_ptr_index_ = 0xBAADF00D;
   read_ptr_index_ = 0;
   primary_buffer_ptr_ = ptr;
   primary_buffer_size_ = uint32_t(1) << (size_log2 + 3);
+  ring_generation_++;
 }
 
 void CommandProcessor::EnableReadPointerWriteBack(uint32_t ptr, uint32_t block_size_log2) {
-- 
