From 2097818022ed2b3188f16e5a56c626d94ea1cf75 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 14:22:46 +0000
Subject: [PATCH] content: a save with an STFS header keeps the header's
 display name

Titles show a save's display name (Ninja Gaiden II's slot text: the
chapter, time and score), and a header from a console or Xenia holds
it in its metadata. Read it from there when such a header is found, so
the folder only lends the file name.
---
 src/system/xam/content_manager.cpp | 31 +++++++++++++++++++++++-------
 1 file changed, 24 insertions(+), 7 deletions(-)

diff --git a/src/system/xam/content_manager.cpp b/src/system/xam/content_manager.cpp
index e6591d6..9c6a53b 100644
--- a/src/system/xam/content_manager.cpp
+++ b/src/system/xam/content_manager.cpp
@@ -21,8 +21,10 @@
 #include <rex/filesystem.h>
 #include <rex/filesystem/devices/host_path_device.h>
 #include <rex/filesystem/devices/stfs_container_device.h>
+#include <rex/filesystem/devices/stfs_xbox.h>
 #include <rex/string.h>
 #include <rex/system/kernel_state.h>
+#include <rex/system/xcontent.h>
 #include <rex/system/xam/content_device.h>
 #include <rex/system/xam/content_manager.h>
 #include <rex/system/xfile.h>
@@ -179,14 +181,16 @@ std::vector<XCONTENT_AGGREGATE_DATA> ContentManager::ListContent(uint32_t device
     // ReadContentHeaderFile's failures are Win32 codes (X_ERROR_FILE_NOT_FOUND
     // is 2), which XSUCCEEDED counts as success: compare with success itself,
     // or a folder without a usable header is listed as an empty record.
-    XCONTENT_AGGREGATE_DATA content_data;
+    XCONTENT_AGGREGATE_DATA content_data{};
     if (ReadContentHeaderFile(rex::path_to_utf8(file_info.name), xuid, title_id, content_type,
                               content_data) == X_ERROR_SUCCESS) {
       result.emplace_back(std::move(content_data));
     } else {
       content_data.device_id = device_id;
       content_data.content_type = content_type;
-      content_data.set_display_name(rex::path_to_utf16(file_info.name));
+      if (content_data.display_name().empty()) {  // (an STFS header's name stays)
+        content_data.set_display_name(rex::path_to_utf16(file_info.name));
+      }
       content_data.set_file_name(rex::path_to_utf8(file_info.name));
       content_data.title_id = title_id;
       content_data.xuid = xuid;
@@ -267,22 +271,35 @@ X_RESULT ContentManager::ReadContentHeaderFile(const std::string_view file_name,
     return X_ERROR_FILE_NOT_FOUND;
   }
 
-  std::array<uint8_t, header_size> buffer;
-  size_t result = fread(buffer.data(), 1, header_size, file);
+  // (an STFS header's metadata too, when the file holds it)
+  std::array<uint8_t, sizeof(rex::filesystem::StfsHeader)> buffer{};
+  size_t result = fread(buffer.data(), 1, buffer.size(), file);
   fclose(file);
 
-  if (result != header_size) {
+  if (result < header_size) {
     return X_ERROR_FILE_NOT_FOUND;
   }
 
   // A header from a console or another emulator (an STFS package header,
   // "CON "/"LIVE"/"PIRS", 40 KB) isn't this layout: read as one, it names a
   // package that doesn't exist, and the title makes a new one over the
-  // player's. Report it missing instead, so the caller uses the folder.
+  // player's. Report it missing, so the caller describes the save from its
+  // folder, but with the display name it holds: titles show it (a save's
+  // slot text: chapter, time, score).
   if (IsStfsHeader(buffer.data())) {
+    if (result >= sizeof(rex::filesystem::StfsHeader)) {
+      const auto* stfs = reinterpret_cast<const rex::filesystem::StfsHeader*>(buffer.data());
+      std::u16string name = stfs->metadata.display_name(XLanguage::kEnglish);
+      for (uint32_t lang = 1; name.empty() && lang <= 12; ++lang) {
+        name = stfs->metadata.display_name(XLanguage(lang));
+      }
+      if (!name.empty()) {
+        data.set_display_name(name);
+      }
+    }
     return X_ERROR_FILE_NOT_FOUND;
   }
-  std::memcpy(&data, buffer.data(), buffer.size());
+  std::memcpy(&data, buffer.data(), header_size);
   if (!SameNameIgnoringCase(data.file_name(), file_name)) {
     return X_ERROR_FILE_NOT_FOUND;
   }
-- 
