From 76edb0c5b8a49971efcc930c849a87a1ba16b85f Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 20:51:40 +0000
Subject: [PATCH] sdl: build the disk audio driver

For silent test runs that still exercise the audio path
(SDL_AUDIO_DRIVER=disk). It is only used when asked for.
---
 thirdparty/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f102b56..d8ef77c 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -284,7 +284,7 @@ set(SDL_OPENGL OFF CACHE BOOL "" FORCE)
 set(SDL_OPENGLES OFF CACHE BOOL "" FORCE)
 
 # Disable dummy drivers
-set(SDL_DISKAUDIO OFF CACHE BOOL "" FORCE)
+set(SDL_DISKAUDIO ON CACHE BOOL "" FORCE)  # silent test runs (SDL_AUDIO_DRIVER=disk)
 set(SDL_DUMMYAUDIO OFF CACHE BOOL "" FORCE)
 set(SDL_DUMMYVIDEO OFF CACHE BOOL "" FORCE)
 
-- 
2.56.0

