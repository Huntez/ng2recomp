From 75c1045abf9e193397fd804dad139b0e583be216 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 18:03:11 +0000
Subject: [PATCH] memory: unlink the shared memory name right after creating it

A killed process left its guest memory file in /dev/shm; test runs that
end by timeout filled it and later runs died with SIGBUS.
---
 src/core/memory_posix.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
index b52bf39..86df3df 100644
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -483,6 +483,10 @@ FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, siz
     shm_unlink(full_path.c_str());
     return kFileMappingHandleInvalid;
   }
+  // The descriptor keeps the memory alive and nothing reopens it by name, so
+  // drop the name now: a process that is killed would otherwise leave a
+  // multi-gigabyte file in /dev/shm behind.
+  shm_unlink(full_path.c_str());
   return static_cast<FileMappingHandle>(ret);
 #endif
 }
-- 
2.56.0

