From 869f24b7e378e84839b91f36acfa24f5784dc229 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Mon, 2 Nov 2026 12:49:50 +0000
Subject: [PATCH] content: installs fail cleanly and start clean

ExtractEntry stopped at a short read and ignored fwrite, so a truncated
package or a full disk installed truncated files and reported success.
InstallContent now removes the package folder on any failure (the game
would list a partial copy) and removes the old folder and header before
a reinstall, so old and new files never mix.
---
 src/system/xam/content_manager.cpp | 32 +++++++++++++++++++++---------
 1 file changed, 23 insertions(+), 9 deletions(-)

diff --git a/src/system/xam/content_manager.cpp b/src/system/xam/content_manager.cpp
index bd6c797..60b9320 100644
--- a/src/system/xam/content_manager.cpp
+++ b/src/system/xam/content_manager.cpp
@@ -556,17 +556,18 @@ static X_RESULT ExtractEntry(rex::filesystem::Entry* entry,
     size_t bytes_read = 0;
     size_t to_read = std::min(remaining, kBufferSize);
     in_file->ReadSync(std::span<uint8_t>(buffer.get(), to_read), offset, &bytes_read);
-    if (bytes_read == 0) {
+    if (bytes_read == 0 || fwrite(buffer.get(), 1, bytes_read, out_file) != bytes_read) {
       break;
     }
-    fwrite(buffer.get(), 1, bytes_read, out_file);
     offset += bytes_read;
     remaining -= bytes_read;
   }
 
-  fclose(out_file);
+  // A short read (truncated package) or a failed write (full disk) is an
+  // error, not a smaller file.
+  bool closed = fclose(out_file) == 0;
   in_file->Destroy();
-  return X_ERROR_SUCCESS;
+  return remaining == 0 && closed ? X_ERROR_SUCCESS : X_ERROR_ACCESS_DENIED;
 }
 
 X_RESULT ContentManager::InstallContent(const std::filesystem::path& package_path) {
@@ -601,17 +602,29 @@ X_RESULT ContentManager::InstallContent(const std::filesystem::path& package_pat
 
   auto install_path = ResolvePackagePath(0, content_data);
 
-  // Create destination directory
+  // A reinstall starts clean (no old files or header mixed with the new),
+  // and a failed install leaves nothing the game would list.
   std::error_code ec;
+  auto header_path = ResolvePackageHeaderPath(file_name, 0, uint32_t(content_data.title_id),
+                                              XContentType::kMarketplaceContent);
+  std::filesystem::remove(header_path, ec);
+  std::filesystem::remove_all(install_path, ec);
+  auto fail = [&](X_RESULT result) {
+    std::error_code ignored;
+    std::filesystem::remove_all(install_path, ignored);
+    return result;
+  };
+
+  // Create destination directory
   std::filesystem::create_directories(install_path, ec);
   if (ec) {
-    return X_ERROR_ACCESS_DENIED;
+    return fail(X_ERROR_ACCESS_DENIED);
   }
 
   // Extract all files breadth-first
   auto* root = device->ResolvePath("");
   if (!root) {
-    return X_ERROR_ACCESS_DENIED;
+    return fail(X_ERROR_ACCESS_DENIED);
   }
 
   std::queue<rex::filesystem::Entry*> queue;
@@ -627,7 +640,7 @@ X_RESULT ContentManager::InstallContent(const std::filesystem::path& package_pat
 
     auto result = ExtractEntry(entry, install_path);
     if (result != X_ERROR_SUCCESS) {
-      return result;
+      return fail(result);
     }
   }
 
@@ -640,7 +653,8 @@ X_RESULT ContentManager::InstallContent(const std::filesystem::path& package_pat
   }
 
   // Write .header file
-  return WriteContentHeaderFile(0, content_data, license_mask);
+  auto result = WriteContentHeaderFile(0, content_data, license_mask);
+  return result == X_ERROR_SUCCESS ? result : fail(result);
 }
 
 }  // namespace xam
