From e77299f3fc34103ee26c12fa8611c6d210a6f5bf Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 21:38:40 +0000
Subject: [PATCH] threading: hand semaphore units to queued waiters, atomic
 SignalAndWait

On the Xbox, NtSignalAndWaitForSingleObjectEx signals and starts waiting
atomically, and a released semaphore unit goes to a thread already
waiting. Here the signal and the wait were separate and a unit went to
whoever looked first, so a worker that came back to wait right after a
release could take a unit meant for one that hadn't woken yet. Ninja
Gaiden II's job system then lost a wake-up and stalled a frame forever.
Semaphore waiters now take a ticket and units go to the oldest tickets;
SignalAndWait queues before it signals; alertable waits keep one ticket.
---
 src/core/threading_posix.cpp | 87 +++++++++++++++++++++++++++++++++---
 1 file changed, 81 insertions(+), 6 deletions(-)

diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 9ac8d15..454ee89 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -21,6 +21,7 @@ static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only")
 #include <deque>
 #include <limits>
 #include <memory>
+#include <set>
 
 #include <pthread.h>
 #include <semaphore.h>
@@ -288,8 +289,30 @@ class PosixConditionBase {
   virtual bool Signal() = 0;
 
   WaitResult Wait(std::chrono::milliseconds timeout) {
+    return WaitQueued(Enqueue(), timeout, true);
+  }
+
+  // Ticketed waits. A semaphore hands released units to the threads already
+  // waiting, oldest first, as the Xbox kernel does; without that, a thread
+  // that comes back to wait right after a release can take a unit meant for
+  // one that hasn't woken yet. Enqueue() takes a place in the queue (0 for
+  // objects without one); WaitQueued() waits with it and, if dequeue_on_timeout
+  // or on success, gives it up; Dequeue() gives it up after a timeout.
+  uint64_t Enqueue() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return enqueue_locked();
+  }
+  void Dequeue(uint64_t ticket) {
+    if (ticket) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      dequeue_locked(ticket);
+    }
+  }
+
+  WaitResult WaitQueued(uint64_t ticket, std::chrono::milliseconds timeout,
+                        bool dequeue_on_timeout) {
     bool executed;
-    auto predicate = [this] { return this->signaled(); };
+    auto predicate = [this, ticket] { return this->signaled_for(ticket); };
 #if REX_PLATFORM_LINUX
     auto native_mutex = static_cast<pthread_mutex_t*>(mutex_.native_handle());
     int lock_result = pthread_mutex_lock(native_mutex);
@@ -313,9 +336,12 @@ class PosixConditionBase {
       }
     }
     if (executed) {
-      post_execution();
+      post_execution_for(ticket);
       return WaitResult::kSuccess;
     } else {
+      if (dequeue_on_timeout && ticket) {
+        dequeue_locked(ticket);
+      }
       return WaitResult::kTimeout;
     }
   }
@@ -428,6 +454,11 @@ class PosixConditionBase {
  protected:
   inline virtual bool signaled() const = 0;
   inline virtual void post_execution() = 0;
+  // With the mutex held. Objects without a wait queue ignore tickets.
+  virtual uint64_t enqueue_locked() { return 0; }
+  virtual void dequeue_locked(uint64_t) {}
+  virtual bool signaled_for(uint64_t) const { return signaled(); }
+  virtual void post_execution_for(uint64_t) { post_execution(); }
   std::condition_variable cond_;
   std::mutex mutex_;
 };
@@ -491,13 +522,38 @@ class PosixCondition<Semaphore> : public PosixConditionBase {
   }
 
  private:
-  inline bool signaled() const override { return count_ > 0; }
+  // Untracked waiters (WaitMultiple) only get units no queued waiter is
+  // owed.
+  inline bool signaled() const override { return count_ > tickets_.size(); }
   inline void post_execution() override {
     count_--;
     cond_.notify_all();
   }
+  uint64_t enqueue_locked() override {
+    uint64_t ticket = next_ticket_++;
+    tickets_.insert(ticket);
+    return ticket;
+  }
+  void dequeue_locked(uint64_t ticket) override {
+    tickets_.erase(ticket);
+    cond_.notify_all();
+  }
+  // The oldest count_ queued waiters may take a unit.
+  bool signaled_for(uint64_t ticket) const override {
+    if (!ticket) {
+      return signaled();
+    }
+    auto it = tickets_.find(ticket);
+    return it != tickets_.end() && uint32_t(std::distance(tickets_.begin(), it)) < count_;
+  }
+  void post_execution_for(uint64_t ticket) override {
+    tickets_.erase(ticket);
+    post_execution();
+  }
   uint32_t count_;
   const uint32_t maximum_count_;
+  std::set<uint64_t> tickets_;
+  uint64_t next_ticket_ = 1;
 };
 
 template <>
@@ -1166,15 +1222,23 @@ WaitResult Wait(WaitHandle* wait_handle, bool is_alertable, std::chrono::millise
   ScopedAlertableState alertable_state_guard(true);
   auto deadline = ComputeAlertableDeadline(timeout);
 
+  // One place in the wait queue for the whole wait, not one per slice.
+  auto& condition = posix_wait_handle->condition();
+  uint64_t ticket = condition.Enqueue();
   while (true) {
     if (DispatchCurrentThreadUserCallback()) {
+      condition.Dequeue(ticket);
       return WaitResult::kUserCallback;
     }
     if (HasAlertableTimeoutElapsed(deadline)) {
+      condition.Dequeue(ticket);
       return WaitResult::kTimeout;
     }
-    auto result = posix_wait_handle->condition().Wait(ComputeAlertableWaitTimeout(deadline));
+    auto result = condition.WaitQueued(ticket, ComputeAlertableWaitTimeout(deadline), false);
     if (result != WaitResult::kTimeout) {
+      if (result != WaitResult::kSuccess) {
+        condition.Dequeue(ticket);
+      }
       return result;
     }
   }
@@ -1188,25 +1252,36 @@ WaitResult SignalAndWait(WaitHandle* wait_handle_to_signal, WaitHandle* wait_han
   if (posix_wait_handle_to_signal == nullptr || posix_wait_handle_to_wait_on == nullptr) {
     return WaitResult::kFailed;
   }
+  // The kernel signals and starts waiting atomically: take the place in the
+  // wait queue before signalling, so a release prompted by the signal finds
+  // this thread already waiting.
+  auto& wait_on = posix_wait_handle_to_wait_on->condition();
+  uint64_t ticket = wait_on.Enqueue();
   if (!posix_wait_handle_to_signal->condition().Signal()) {
+    wait_on.Dequeue(ticket);
     return WaitResult::kFailed;
   }
 
   if (!is_alertable) {
-    return posix_wait_handle_to_wait_on->condition().Wait(timeout);
+    return wait_on.WaitQueued(ticket, timeout, true);
   }
 
   ScopedAlertableState alertable_state_guard(true);
   auto deadline = ComputeAlertableDeadline(timeout);
   while (true) {
     if (DispatchCurrentThreadUserCallback()) {
+      wait_on.Dequeue(ticket);
       return WaitResult::kUserCallback;
     }
     if (HasAlertableTimeoutElapsed(deadline)) {
+      wait_on.Dequeue(ticket);
       return WaitResult::kTimeout;
     }
-    result = posix_wait_handle_to_wait_on->condition().Wait(ComputeAlertableWaitTimeout(deadline));
+    result = wait_on.WaitQueued(ticket, ComputeAlertableWaitTimeout(deadline), false);
     if (result != WaitResult::kTimeout) {
+      if (result != WaitResult::kSuccess) {
+        wait_on.Dequeue(ticket);
+      }
       return result;
     }
   }
-- 
