From 732065f4429941e8444881838a5252ef332dcc43 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 00:57:43 +0000
Subject: [PATCH] content: Xenia and console save headers no longer hide the
 save

ListContent counted a header read's failure as success (its Win32
codes don't set the high bit XSUCCEEDED tests), so a save folder
without a usable header was listed as an empty record. An STFS
header ("CON ", from a console or Xenia) was also read as this
layout. Either way the title didn't find its save and made a new
one over it.

Compare with success, report STFS headers and headers naming another
folder as missing, so the folder itself describes the save, and skip
the license read for STFS headers.
---
 src/kernel/xam/xam_content.cpp     |  5 ++--
 src/system/xam/content_manager.cpp | 40 ++++++++++++++++++++++++++++--
 2 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/src/kernel/xam/xam_content.cpp b/src/kernel/xam/xam_content.cpp
index 1fb1e16..0a3437a 100644
--- a/src/kernel/xam/xam_content.cpp
+++ b/src/kernel/xam/xam_content.cpp
@@ -209,14 +209,15 @@ u32 xeXamContentCreate(u32 user_index, mapped_string root_name, mapped_void cont
     uint32_t content_license = 0;
     if (disposition == kDispositionState::Create) {
       result = content_manager->CreateContent(root_name, xuid, content_data);
-      if (XSUCCEEDED(result)) {
+      // Its failures are Win32 codes, which XSUCCEEDED counts as success.
+      if (result == X_ERROR_SUCCESS) {
         content_manager->WriteContentHeaderFile(xuid, content_data);
       }
     } else if (disposition == kDispositionState::Open) {
       result = content_manager->OpenContent(root_name, xuid, content_data, content_license);
     }
 
-    if (license_mask_ptr && XSUCCEEDED(result)) {
+    if (license_mask_ptr && result == X_ERROR_SUCCESS) {
       *license_mask_ptr = content_license;
     }
 
diff --git a/src/system/xam/content_manager.cpp b/src/system/xam/content_manager.cpp
index 60b9320..e6591d6 100644
--- a/src/system/xam/content_manager.cpp
+++ b/src/system/xam/content_manager.cpp
@@ -9,7 +9,9 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <algorithm>
 #include <array>
+#include <cctype>
 #include <cstring>
 #include <queue>
 #include <string>
@@ -59,6 +61,20 @@ ContentPackage::~ContentPackage() {
   fs->UnregisterDevice(device_path_);
 }
 
+namespace {
+bool IsStfsHeader(const uint8_t* bytes) {
+  return std::memcmp(bytes, "CON ", 4) == 0 || std::memcmp(bytes, "LIVE", 4) == 0 ||
+         std::memcmp(bytes, "PIRS", 4) == 0;
+}
+
+bool SameNameIgnoringCase(std::string_view a, std::string_view b) {
+  return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+           return std::tolower(static_cast<unsigned char>(x)) ==
+                  std::tolower(static_cast<unsigned char>(y));
+         });
+}
+}  // namespace
+
 void ContentPackage::LoadPackageLicenseMask(const std::filesystem::path header_path) {
   if (!std::filesystem::exists(header_path)) {
     return;
@@ -75,6 +91,11 @@ void ContentPackage::LoadPackageLicenseMask(const std::filesystem::path header_p
     return;
   }
 
+  uint8_t magic[4] = {};
+  if (fread(magic, 1, sizeof(magic), file) != sizeof(magic) || IsStfsHeader(magic)) {
+    fclose(file);
+    return;
+  }
   fseek(file, sizeof(XCONTENT_AGGREGATE_DATA), SEEK_SET);
   fread(&license_, 1, sizeof(license_), file);
   fclose(file);
@@ -155,9 +176,12 @@ std::vector<XCONTENT_AGGREGATE_DATA> ContentManager::ListContent(uint32_t device
       continue;
     }
 
+    // ReadContentHeaderFile's failures are Win32 codes (X_ERROR_FILE_NOT_FOUND
+    // is 2), which XSUCCEEDED counts as success: compare with success itself,
+    // or a folder without a usable header is listed as an empty record.
     XCONTENT_AGGREGATE_DATA content_data;
-    if (XSUCCEEDED(ReadContentHeaderFile(rex::path_to_utf8(file_info.name), xuid, title_id,
-                                         content_type, content_data))) {
+    if (ReadContentHeaderFile(rex::path_to_utf8(file_info.name), xuid, title_id, content_type,
+                              content_data) == X_ERROR_SUCCESS) {
       result.emplace_back(std::move(content_data));
     } else {
       content_data.device_id = device_id;
@@ -251,7 +275,19 @@ X_RESULT ContentManager::ReadContentHeaderFile(const std::string_view file_name,
     return X_ERROR_FILE_NOT_FOUND;
   }
 
+  // A header from a console or another emulator (an STFS package header,
+  // "CON "/"LIVE"/"PIRS", 40 KB) isn't this layout: read as one, it names a
+  // package that doesn't exist, and the title makes a new one over the
+  // player's. Report it missing instead, so the caller uses the folder.
+  if (IsStfsHeader(buffer.data())) {
+    return X_ERROR_FILE_NOT_FOUND;
+  }
   std::memcpy(&data, buffer.data(), buffer.size());
+  if (!SameNameIgnoringCase(data.file_name(), file_name)) {
+    return X_ERROR_FILE_NOT_FOUND;
+  }
+  // The folder's spelling: paths are case-sensitive on Linux.
+  data.set_file_name(file_name);
   return X_ERROR_SUCCESS;
 }
 
-- 
