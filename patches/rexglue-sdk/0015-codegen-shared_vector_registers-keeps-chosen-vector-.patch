From c03212ccf79c1db60ea5a50e21423ead5bf4aae6 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Tue, 3 Nov 2026 19:07:45 +0000
Subject: [PATCH] codegen: shared_vector_registers keeps chosen vector
 registers in ctx

With non_volatile_as_local, vector registers a title passes values in
between functions (read before written by the callee) must stay in the
shared context; shared_vector_registers = [n, ...] lists them.
---
 include/rex/codegen/config.h     | 5 +++++
 src/codegen/builders/context.cpp | 3 +++
 src/codegen/config.cpp           | 9 +++++++++
 3 files changed, 17 insertions(+)

diff --git a/include/rex/codegen/config.h b/include/rex/codegen/config.h
index 8200139..ef5f942 100644
--- a/include/rex/codegen/config.h
+++ b/include/rex/codegen/config.h
@@ -11,6 +11,8 @@
 
 #pragma once
 
+#include <bitset>
+
 #include <cstdint>
 #include <filesystem>
 #include <optional>
@@ -96,6 +98,9 @@ struct RecompilerConfig {
   bool crRegistersAsLocalVariables = false;
   bool nonArgumentRegistersAsLocalVariables = false;
   bool nonVolatileRegistersAsLocalVariables = false;
+  /// Vector registers kept in the shared context even when non-volatiles are locals: ones the
+  /// game's code passes values in between functions (shared_vector_registers = [64, 65, ...]).
+  std::bitset<128> sharedVectorRegisters;
   bool generateExceptionHandlers = false;  ///< Generate SEH exception handler wrappers
 
   // === Analysis tuning (optional) ===
diff --git a/src/codegen/builders/context.cpp b/src/codegen/builders/context.cpp
index f78e0d8..73f0277 100644
--- a/src/codegen/builders/context.cpp
+++ b/src/codegen/builders/context.cpp
@@ -71,6 +71,9 @@ std::string BuilderContext::f(size_t index) {
 
 std::string BuilderContext::v(size_t index) {
   const auto& cfg = config();
+  if (index < cfg.sharedVectorRegisters.size() && cfg.sharedVectorRegisters.test(index)) {
+    return fmt::format("ctx.v{}", index);
+  }
   if ((cfg.nonArgumentRegistersAsLocalVariables && (index >= 32 && index <= 63)) ||
       (localizeNonVolatiles() && ((index >= 14 && index <= 31) || (index >= 64 && index <= 127)))) {
     locals.v[index] = true;
diff --git a/src/codegen/config.cpp b/src/codegen/config.cpp
index 5da54a0..cf811ef 100644
--- a/src/codegen/config.cpp
+++ b/src/codegen/config.cpp
@@ -116,6 +116,15 @@ void ApplyToml(const toml::table& toml, RecompilerConfig& cfg, const std::string
             hasBool("non_volatile_as_local"), "non_volatile_as_local");
   MergeBool(cfg.generateExceptionHandlers, toml["generate_exception_handlers"].value_or(false),
             hasBool("generate_exception_handlers"), "generate_exception_handlers");
+  if (auto shared = toml["shared_vector_registers"].as_array()) {
+    for (auto& entry : *shared) {
+      if (auto index = entry.value<int64_t>(); index && *index >= 0 && *index < 128) {
+        cfg.sharedVectorRegisters.set(size_t(*index));
+      } else {
+        REXCODEGEN_ERROR("shared_vector_registers: expected register numbers 0-127");
+      }
+    }
+  }
   if (hasBool("is_dll")) {
     cfg.isDll = toml["is_dll"].value_or(false);
   }
-- 
