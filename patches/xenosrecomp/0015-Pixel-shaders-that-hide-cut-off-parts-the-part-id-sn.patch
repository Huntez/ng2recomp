From 247ae6a330ad556a2fade7de50f15eb5353c026f Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Fri, 6 Nov 2026 04:04:33 +0000
Subject: [PATCH] Pixel shaders that hide cut-off parts: the part id snapped to
 a whole number, not read flat

Reading TEXCOORD6 flat made the triangles joining two parts take one
vertex's id: cut limbs showed long stretched triangles to the body. It stays
interpolated, and .y, the part's id (a whole number), is snapped to it when
within 0.001: on NVIDIA it came out a hair off inside a part (speckled cut
limbs, and 4.99995 taken as part 4 by the two shaders that compare whole
numbers).
---
 XenosRecomp/shader_recompiler.cpp | 10 ++++------
 XenosRecomp/shader_recompiler.h   | 14 +++++++++-----
 2 files changed, 13 insertions(+), 11 deletions(-)

diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index e2b54c3..7836e97 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1305,7 +1305,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         const char* constantName = reinterpret_cast<const char*>(constantTableData + constantInfo->name);
 
         if (isPixelShader && strcmp(constantName, "SupDel") == 0)
-            flatTexCoord6 = true;
+            snapTexCoord6 = true;
 
     #ifdef UNLEASHED_RECOMP
         if (!isPixelShader)
@@ -1487,11 +1487,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         out += "\tin float4 iPos : SV_Position,\n";
 
         for (auto& [usage, usageIndex] : INTERPOLATORS)
-        {
-            bool flat = flatTexCoord6 && usage == DeclUsage::TexCoord && usageIndex == 6;
-            println("\tin {3}float4 i{0}{1} : {2}{1},", USAGE_VARIABLES[uint32_t(usage)], usageIndex, USAGE_SEMANTICS[uint32_t(usage)],
-                flat ? "nointerpolation " : "");
-        }
+            println("\tin float4 i{0}{1} : {2}{1},", USAGE_VARIABLES[uint32_t(usage)], usageIndex, USAGE_SEMANTICS[uint32_t(usage)]);
 
         out += "#ifdef __spirv__\n";
         out += "\tin bool iFace : SV_IsFrontFace\n";
@@ -1672,6 +1668,8 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         {
             value = reinterpret_cast<const PixelShader*>(shader)->interpolators[i];
             println("\tfloat4 r{} = i{}{};", uint32_t(interpolator.reg), USAGE_VARIABLES[uint32_t(interpolator.usage)], uint32_t(interpolator.usageIndex));
+            if (snapTexCoord6 && interpolator.usage == DeclUsage::TexCoord && interpolator.usageIndex == 6)
+                println("\tr{0}.y = abs(r{0}.y - round(r{0}.y)) < 0.001 ? round(r{0}.y) : r{0}.y;", uint32_t(interpolator.reg));
             printedRegisters[interpolator.reg] = true;
         }
         else
diff --git a/XenosRecomp/shader_recompiler.h b/XenosRecomp/shader_recompiler.h
index 0889188..4634340 100644
--- a/XenosRecomp/shader_recompiler.h
+++ b/XenosRecomp/shader_recompiler.h
@@ -25,11 +25,15 @@ struct ShaderRecompiler : StringBuffer
 {
     uint32_t indentation = 0;
     bool isPixelShader = false;
-    // NG2: a pixel shader that hides a character's cut-off parts compares
-    // TEXCOORD6.y (the part's id, the same at each of its vertices) with the
-    // ids in SupDel to 0.0001. Interpolated, it comes out a hair off at some
-    // pixels on NVIDIA: those parts showed speckled. Read flat, it's exact.
-    bool flatTexCoord6 = false;
+    // NG2: a pixel shader that hides a character's cut-off parts reads
+    // TEXCOORD6.y, the part's id (a whole number), and compares it with the
+    // ids in SupDel: to 0.0001, or (two shaders) by its whole-number part.
+    // Interpolated, it comes out a hair off inside a part on NVIDIA (speckled
+    // cut limbs; 4.99995 taken as part 4); it is snapped to the whole number
+    // when within 0.001 of one. It stays interpolated: the triangles joining
+    // two parts must get in-between values, as on the console (flat made the
+    // joins of cut limbs show as long stretched triangles).
+    bool snapTexCoord6 = false;
     const uint8_t* constantTableData = nullptr;
     std::unordered_map<uint32_t, VertexElement> vertexElements;
     std::unordered_map<uint32_t, std::string> interpolators;
-- 
