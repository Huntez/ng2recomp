From 536c273e3cdb586bc0fad5712d8124881c12e69e Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Fri, 6 Nov 2026 21:50:23 +0000
Subject: [PATCH] Barycentric variant: Flat taken off the inputs read per
 vertex

DXC decorates a nointerpolation input read with GetAttributeAtVertex both
Flat and PerVertexKHR. With both, RADV killed nearly every pixel of the
shaders that hide cut-off parts (characters' bodies missing). Without Flat
they draw normally there. Taken out of the SPIR-V before it is encoded.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 XenosRecomp/main.cpp | 32 +++++++++++++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/main.cpp b/XenosRecomp/main.cpp
index aa2ed99..7d6061b 100644
--- a/XenosRecomp/main.cpp
+++ b/XenosRecomp/main.cpp
@@ -21,6 +21,33 @@ static void writeAllBytes(const char* filePath, const void* data, size_t dataSiz
     fclose(file);
 }
 
+// DXC decorates a nointerpolation input read with GetAttributeAtVertex both
+// Flat and PerVertexKHR: Flat is taken out, the input is read per vertex.
+static std::vector<uint32_t> withoutFlatOnPerVertexInputs(const void* spirv, size_t size)
+{
+    constexpr uint32_t OP_DECORATE = 71, DECORATION_FLAT = 14, DECORATION_PER_VERTEX = 5285, HEADER_WORDS = 5;
+
+    const uint32_t* words = static_cast<const uint32_t*>(spirv);
+    const size_t count = size / sizeof(uint32_t);
+
+    std::vector<uint32_t> perVertex;
+    for (size_t i = HEADER_WORDS; i < count; i += words[i] >> 16)
+    {
+        if ((words[i] & 0xFFFF) == OP_DECORATE && words[i + 2] == DECORATION_PER_VERTEX)
+            perVertex.push_back(words[i + 1]);
+    }
+
+    std::vector<uint32_t> out(words, words + HEADER_WORDS);
+    for (size_t i = HEADER_WORDS; i < count; i += words[i] >> 16)
+    {
+        const bool isFlatOnPerVertex = (words[i] & 0xFFFF) == OP_DECORATE && words[i + 2] == DECORATION_FLAT &&
+            std::find(perVertex.begin(), perVertex.end(), words[i + 1]) != perVertex.end();
+        if (!isFlatOnPerVertex)
+            out.insert(out.end(), words + i, words + i + (words[i] >> 16));
+    }
+    return out;
+}
+
 struct RecompiledShader
 {
     uint8_t* data = nullptr;
@@ -166,8 +193,11 @@ int main(int argc, char** argv)
                 if (recompiler.snapTexCoord6)
                 {
                     IDxcBlob* variant = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, false, true, true);
+                    std::vector<uint32_t> variantWords;
+                    if (variant != nullptr)
+                        variantWords = withoutFlatOnPerVertexInputs(variant->GetBufferPointer(), variant->GetBufferSize());
                     if (variant == nullptr ||
-                        !smolv::Encode(variant->GetBufferPointer(), variant->GetBufferSize(), shader.spirvBarycentric, smolv::kEncodeFlagStripDebugInfo))
+                        !smolv::Encode(variantWords.data(), variantWords.size() * sizeof(uint32_t), shader.spirvBarycentric, smolv::kEncodeFlagStripDebugInfo))
                     {
                         fmt::println(stderr, "SPIR-V barycentric variant failed for shader {:016X}", hashShaderPair.first);
                         failed = true;
