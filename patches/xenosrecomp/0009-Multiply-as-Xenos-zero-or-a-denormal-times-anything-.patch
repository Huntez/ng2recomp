From 78513c658c5cc28c0dd8c2f4c7e2f901c58ae332 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 1 Nov 2026 21:31:05 +0000
Subject: [PATCH] Multiply as Xenos: zero or a denormal times anything is zero

Shader Model 3's rule, which Xenia emulates (ZeroIfAnyOperandIsZero): mul,
mad, dp2add/dp3/dp4, dst's y, muls, mulsprev and mulsc give 0 when either
operand is +-0 or denormal, even against NaN or an infinity. Ninja Gaiden II
blends a garbage position stream (NaN) with a weight of 0 on Sonia's skin;
plain multiplies turned those vertices into NaN and left a hole.
---
 XenosRecomp/shader_common.h       | 18 ++++++++++++++++--
 XenosRecomp/shader_recompiler.cpp | 14 +++++++-------
 2 files changed, 23 insertions(+), 9 deletions(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index c2ea56c..02c8f1a 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -16,6 +16,20 @@
 #define FLT_MIN asfloat(0xff7fffff)
 #define FLT_MAX asfloat(0x7f7fffff)
 
+// Xenos multiplies as Shader Model 3: +-0 or a denormal times anything (an
+// infinity or NaN too) is 0. Games rely on it: a blend weight of 0 hides a
+// garbage stream (NaN) instead of turning the vertex into NaN. After Xenia's
+// ZeroIfAnyOperandIsZero.
+#define XE_MUL_ZERO(T) \
+    precise T mulz(T a, T b) { return select(or(abs(a) < asfloat(0x00800000), abs(b) < asfloat(0x00800000)), (T)0.0, a * b); }
+XE_MUL_ZERO(float)
+XE_MUL_ZERO(float2)
+XE_MUL_ZERO(float3)
+XE_MUL_ZERO(float4)
+precise float dotz(float4 a, float4 b) { precise float4 p = mulz(a, b); return p.x + p.y + p.z + p.w; }
+precise float dotz(float3 a, float3 b) { precise float3 p = mulz(a, b); return p.x + p.y + p.z; }
+precise float dotz(float2 a, float2 b) { precise float2 p = mulz(a, b); return p.x + p.y; }
+
 #ifdef __spirv__
 
 struct PushConstants
@@ -240,11 +254,11 @@ float4 cube(float4 value, inout CubeMapData cubeMapData)
     return float4(0.0, 0.0, 0.0, index);
 }
 
-float4 dst(float4 src0, float4 src1)
+precise float4 dst(float4 src0, float4 src1)
 {
     float4 dest;
     dest.x = 1.0;
-    dest.y = src0.y * src1.y;
+    dest.y = mulz(src0.y, src1.y);
     dest.z = src0.z;
     dest.w = src1.w;
     return dest;
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 76cb67f..df822e1 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -828,7 +828,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluVectorOpcode::Mul:
-            print("{} * {}", op(VECTOR_0), op(VECTOR_1));
+            print("mulz({}, {})", op(VECTOR_0), op(VECTOR_1));
             break;
 
         case AluVectorOpcode::Max:
@@ -869,7 +869,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluVectorOpcode::Mad:
-            print("{} * {} + {}", op(VECTOR_0), op(VECTOR_1), op(VECTOR_2));
+            print("mulz({}, {}) + {}", op(VECTOR_0), op(VECTOR_1), op(VECTOR_2));
             break;
 
         case AluVectorOpcode::CndEq:
@@ -886,11 +886,11 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
 
         case AluVectorOpcode::Dp4:
         case AluVectorOpcode::Dp3:
-            print("dot({}, {})", op(VECTOR_0), op(VECTOR_1));
+            print("dotz({}, {})", op(VECTOR_0), op(VECTOR_1));
             break;
 
         case AluVectorOpcode::Dp2Add:
-            print("dot({}, {}) + {}", op(VECTOR_0), op(VECTOR_1), op(VECTOR_2));
+            print("dotz({}, {}) + {}", op(VECTOR_0), op(VECTOR_1), op(VECTOR_2));
             break;
 
         case AluVectorOpcode::Cube:
@@ -996,12 +996,12 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluScalarOpcode::Muls:
-            print("{} * {}", op(SCALAR_0), op(SCALAR_1));
+            print("mulz({}, {})", op(SCALAR_0), op(SCALAR_1));
             break;
 
         case AluScalarOpcode::MulsPrev:
         case AluScalarOpcode::MulsPrev2:
-            print("{} * ps", op(SCALAR_0));
+            print("mulz({}, ps)", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::Maxs:
@@ -1120,7 +1120,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
 
         case AluScalarOpcode::Mulsc0:
         case AluScalarOpcode::Mulsc1:
-            print("{} * {}", op(SCALAR_CONSTANT_0), op(SCALAR_CONSTANT_1));
+            print("mulz({}, {})", op(SCALAR_CONSTANT_0), op(SCALAR_CONSTANT_1));
             break;
 
         case AluScalarOpcode::Addsc0:
