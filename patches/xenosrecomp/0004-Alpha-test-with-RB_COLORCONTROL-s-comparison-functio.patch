From 027207bcaa96c760ed9de60077f4cdb213cf9c3c Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 23:39:50 +0000
Subject: [PATCH] Alpha test with RB_COLORCONTROL's comparison function

The test was always alpha >= reference; the function now comes from the
shared constants (offset 1736).
---
 XenosRecomp/shader_common.h       | 24 ++++++++++++++++++++++++
 XenosRecomp/shader_recompiler.cpp |  2 +-
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index bccf11c..2699e79 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -48,6 +48,7 @@ struct PushConstants
 #define g_VertexFetch(i)           vk::RawBufferLoad<uint2>(g_PushConstants.SharedConstants + 696 + (i) * 8)
 #define g_VertexElement(i)         vk::RawBufferLoad<uint4>(g_PushConstants.SharedConstants + 1464 + (i) * 16)
 #define g_NdcTransform             vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + 1720, 0x10)
+#define g_AlphaFunc                vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 1736)
 
 [[vk::constant_id(0)]] const uint g_SpecConstants = 0;
 
@@ -273,6 +274,29 @@ uint4 memExportSwap(uint4 v, uint endian)
 
 // Vertex fetch without a declared element, after Xenia: the fetch constant
 // gives the dword address (dword 0) and endianness (dword 1, bits 0-1).
+// Alpha test with RB_COLORCONTROL's function (never, <, ==, <=, >, !=, >=,
+// always) against the reference value.
+bool alphaTestPasses(float alpha)
+{
+#ifdef __spirv__
+    uint func = g_AlphaFunc;
+#else
+    uint func = 6;
+#endif
+    float reference = g_AlphaThreshold;
+    switch (func)
+    {
+    case 0: return false;
+    case 1: return alpha < reference;
+    case 2: return alpha == reference;
+    case 3: return alpha <= reference;
+    case 4: return alpha > reference;
+    case 5: return alpha != reference;
+    case 6: return alpha >= reference;
+    default: return true;
+    }
+}
+
 // Guest physical memory is 512 MB; addresses wrap like the console's, which
 // also keeps a garbage index (an unused stream, NaN) inside the buffer
 // instead of faulting the GPU.
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index c8149e5..6e02845 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1984,7 +1984,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
                     out += '{';
 
                     indent();
-                    out += "\tclip(oC0.w - g_AlphaThreshold);\n";
+                    out += "\tif (!alphaTestPasses(oC0.w)) discard;\n";
 
                     indent();
                     out += "}";
-- 
