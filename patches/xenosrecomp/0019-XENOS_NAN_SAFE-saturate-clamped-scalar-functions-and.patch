From b235cd55dd736907e66ed7a516ce22698cfe9236 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 13:07:48 +0000
Subject: [PATCH] XENOS_NAN_SAFE: saturate, clamped scalar functions and sqrt
 drop NaNs first (a test for Intel GPUs)

---
 XenosRecomp/shader_common.h       | 13 +++++++++++++
 XenosRecomp/shader_recompiler.cpp | 22 ++++++++++++++++------
 2 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index d07f5ce..2479cf0 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -26,6 +26,19 @@ XE_MUL_ZERO(float)
 XE_MUL_ZERO(float2)
 XE_MUL_ZERO(float3)
 XE_MUL_ZERO(float4)
+// NaN-safe clamps (XENOS_NAN_SAFE at translation, a test for Intel GPUs,
+// #18): where NVIDIA's and AMD's saturate/min/max drop a NaN operand, Intel's
+// may keep it, so a NaN anywhere turns a pixel white. These make the NaN a 0
+// before clamping, which is what Xenos itself does for a saturated result.
+#define XE_NAN_SAFE(T) \
+    precise T xsat(T v) { return saturate(select(isnan(v), (T)0.0, v)); } \
+    precise T xclamp(T v) { return clamp(select(isnan(v), (T)0.0, v), FLT_MIN, FLT_MAX); }
+XE_NAN_SAFE(float)
+XE_NAN_SAFE(float2)
+XE_NAN_SAFE(float3)
+XE_NAN_SAFE(float4)
+precise float xsqrt(float v) { return sqrt(max(v, 0.0)); }
+
 precise float dotz(float4 a, float4 b) { precise float4 p = mulz(a, b); return p.x + p.y + p.z + p.w; }
 precise float dotz(float3 a, float3 b) { precise float3 p = mulz(a, b); return p.x + p.y + p.z; }
 precise float dotz(float2 a, float2 b) { precise float2 p = mulz(a, b); return p.x + p.y; }
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 15ee3b3..510124b 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1,6 +1,16 @@
 #include "shader_recompiler.h"
+#include <cstdlib>
 #include "shader_common.h"
 
+// XENOS_NAN_SAFE=1 at translation: saturate, the clamped scalar functions
+// and sqrt drop NaNs first (shader_common.h, a test for Intel GPUs).
+static bool nanSafe()
+{
+    static const bool on = std::getenv("XENOS_NAN_SAFE") != nullptr;
+    return on;
+}
+
+
 static constexpr char SWIZZLES[] = 
 { 
     'x',
@@ -846,7 +856,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
         out += " = ";
 
         if (instr.vectorSaturate)
-            out += "saturate(";
+            out += nanSafe() ? "xsat(" : "saturate(";
 
         switch (instr.vectorOpcode)
         {
@@ -1013,7 +1023,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
         indent();
         out += "ps = ";
         if (instr.scalarSaturate)
-            out += "saturate(";
+            out += nanSafe() ? "xsat(" : "saturate(";
 
         switch (instr.scalarOpcode)
         {
@@ -1078,19 +1088,19 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
 
         case AluScalarOpcode::Logc:
         case AluScalarOpcode::Log:
-            print("clamp(log2({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
+            print(nanSafe() ? "xclamp(log2({}))" : "clamp(log2({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::Rcpc:
         case AluScalarOpcode::Rcpf:
         case AluScalarOpcode::Rcp:
-            print("clamp(rcp({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
+            print(nanSafe() ? "xclamp(rcp({}))" : "clamp(rcp({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::Rsqc:
         case AluScalarOpcode::Rsqf:
         case AluScalarOpcode::Rsq:
-            print("clamp(rsqrt({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
+            print(nanSafe() ? "xclamp(rsqrt({}))" : "clamp(rsqrt({}), FLT_MIN, FLT_MAX)", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::Subs:
@@ -1146,7 +1156,7 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
             break;
 
         case AluScalarOpcode::Sqrt:
-            print("sqrt({})", op(SCALAR_0));
+            print(nanSafe() ? "xsqrt({})" : "sqrt({})", op(SCALAR_0));
             break;
 
         case AluScalarOpcode::Mulsc0:
