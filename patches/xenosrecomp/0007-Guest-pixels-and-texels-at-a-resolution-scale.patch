From a7ffacf44e869cb866318b468e24cda4bc26104c Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 29 Oct 2026 18:20:48 +0000
Subject: [PATCH] Guest pixels and texels at a resolution scale

The renderer can draw at several times the game's size. The pixel shader
position (r0 / vPos) is in guest pixels: (iPos - 0.5) / g_ResolutionScale
(shared constant 1740), so floor() still finds the guest pixel. A texture
index carries its render scale above bit 20; fetch offsets, filter
weights and bicubic taps use the guest size.
---
 XenosRecomp/shader_common.h       | 40 ++++++++++++++++++++++---------
 XenosRecomp/shader_recompiler.cpp |  2 +-
 2 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 0d4324c..c2ea56c 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -40,6 +40,8 @@ struct PushConstants
 //     swap red/blue << 11
 // 1720 NDC transform (float4): oPos.xy = oPos.xy * xy + zw * oPos.w; identity
 //     with the hardware viewport transform, pixels to NDC without it
+// 1736 alpha test function, 1740 resolution scale: host pixels per guest
+//     pixel (the pixel shader position is in guest pixels)
 #define g_Booleans(i)              vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 640 + (i) * 4)
 #define g_SwappedTexcoords         vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 672)
 #define g_AlphaThreshold           vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 676)
@@ -49,6 +51,7 @@ struct PushConstants
 #define g_VertexElement(i)         vk::RawBufferLoad<uint4>(g_PushConstants.SharedConstants + 1464 + (i) * 16)
 #define g_NdcTransform             vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + 1720, 0x10)
 #define g_AlphaFunc                vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 1736)
+#define g_ResolutionScale          vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 1740)
 
 [[vk::constant_id(0)]] const uint g_SpecConstants = 0;
 
@@ -63,6 +66,7 @@ struct PushConstants
     float2 g_HalfPixelOffset : packoffset(c18.z);
 
 #define g_Booleans(i) g_BooleanWords[(i) >> 2][(i) & 3]
+#define g_ResolutionScale 1.0
 
 uint g_SpecConstants();
 
@@ -86,22 +90,36 @@ uint2 getTexture2DDimensions(Texture2D<float4> texture)
     return dimensions;
 }
 
+// A texture index carries its render scale above bit 20 (textures resolved
+// from scaled render targets: scale - 1); fetch offsets, filter weights and
+// bicubic taps are in the guest's texels.
+uint textureHeapIndex(uint resourceDescriptorIndex)
+{
+    return resourceDescriptorIndex & 0xFFFFFu;
+}
+
+float2 getGuestTexture2DDimensions(uint resourceDescriptorIndex)
+{
+    return float2(getTexture2DDimensions(g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)])) /
+        float((resourceDescriptorIndex >> 20) + 1);
+}
+
 float4 tfetch2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
 {
-    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
-    return SAMPLE(texture, g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / getTexture2DDimensions(texture));
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)];
+    return SAMPLE(texture, g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / getGuestTexture2DDimensions(resourceDescriptorIndex));
 }
 
 float4 tfetch1D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float texCoord, float offset)
 {
-    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
-    return SAMPLE(texture, g_SamplerDescriptorHeap[samplerDescriptorIndex], float2(texCoord + offset / getTexture2DDimensions(texture).x, 0.5));
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)];
+    return SAMPLE(texture, g_SamplerDescriptorHeap[samplerDescriptorIndex], float2(texCoord + offset / getGuestTexture2DDimensions(resourceDescriptorIndex).x, 0.5));
 }
 
 float2 getWeights2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
 {
-    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
-    return select(isnan(texCoord), 0.0, frac(texCoord * getTexture2DDimensions(texture) + offset - 0.5));
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)];
+    return select(isnan(texCoord), 0.0, frac(texCoord * getGuestTexture2DDimensions(resourceDescriptorIndex) + offset - 0.5));
 }
 
 float w0(float a)
@@ -146,9 +164,9 @@ float h1(float a)
 
 float4 tfetch2DBicubic(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
 {
-    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)];
     SamplerState samplerState = g_SamplerDescriptorHeap[samplerDescriptorIndex];
-    uint2 dimensions = getTexture2DDimensions(texture);
+    float2 dimensions = getGuestTexture2DDimensions(resourceDescriptorIndex);
     
     float x = texCoord.x * dimensions.x + offset.x;
     float y = texCoord.y * dimensions.y + offset.y;
@@ -178,7 +196,7 @@ float4 tfetch2DBicubic(uint resourceDescriptorIndex, uint samplerDescriptorIndex
 
 float4 tfetch3D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord)
 {
-    return SAMPLE(g_Texture3DDescriptorHeap[resourceDescriptorIndex], g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord);
+    return SAMPLE(g_Texture3DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)], g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord);
 }
 
 struct CubeMapData
@@ -189,7 +207,7 @@ struct CubeMapData
 
 float4 tfetchCube(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord, inout CubeMapData cubeMapData)
 {
-    return SAMPLE(g_TextureCubeDescriptorHeap[resourceDescriptorIndex], g_SamplerDescriptorHeap[samplerDescriptorIndex], cubeMapData.cubeMapDirections[texCoord.z]);
+    return SAMPLE(g_TextureCubeDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)], g_SamplerDescriptorHeap[samplerDescriptorIndex], cubeMapData.cubeMapDirections[texCoord.z]);
 }
 
 float4 tfetchR11G11B10(uint4 value)
@@ -239,7 +257,7 @@ float4 max4(float4 src0)
 
 float2 getPixelCoord(uint resourceDescriptorIndex, float2 texCoord)
 {
-    return getTexture2DDimensions(g_Texture2DDescriptorHeap[resourceDescriptorIndex]) * texCoord;
+    return getTexture2DDimensions(g_Texture2DDescriptorHeap[textureHeapIndex(resourceDescriptorIndex)]) * texCoord;
 }
 
 float computeMipLevel(float2 pixelCoord)
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 6eb88f3..ef9b60c 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1630,7 +1630,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
             print("\tfloat4 r{} = ", i);
             if (isPixelShader && i == ((shader->fieldC >> 8) & 0xFF))
             {
-                out += "float4((iPos.xy - 0.5) * float2(iFace ? 1.0 : -1.0, 1.0), 0.0, 0.0);\n";
+                out += "float4((iPos.xy - 0.5) / g_ResolutionScale * float2(iFace ? 1.0 : -1.0, 1.0), 0.0, 0.0);\n";
             }
         #ifdef UNLEASHED_RECOMP
             else if (!isPixelShader && hasIndexCount && i == 0)
