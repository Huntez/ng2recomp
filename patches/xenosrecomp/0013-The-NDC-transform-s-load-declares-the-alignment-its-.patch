From fe7f2dfbdcc058e0e0b61ca795834a12be752ba3 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 5 Nov 2026 17:54:13 +0000
Subject: [PATCH] The NDC transform's load declares the alignment its offset
 has (8, not 16)

Shared constants + 1720 is 8-aligned. A float4 load declared 16-aligned there
works on AMD's hardware and reads garbage on NVIDIA's, which put every vertex
off screen: a black screen with sound and input working (ng2recomp #1, #3, #4,
#6, #7, #8, #10).
---
 XenosRecomp/shader_common.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 02c8f1a..d07f5ce 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -63,7 +63,9 @@ struct PushConstants
 #define g_GuestMemoryBase          vk::RawBufferLoad<uint64_t>(g_PushConstants.SharedConstants + 688, 8)
 #define g_VertexFetch(i)           vk::RawBufferLoad<uint2>(g_PushConstants.SharedConstants + 696 + (i) * 8)
 #define g_VertexElement(i)         vk::RawBufferLoad<uint4>(g_PushConstants.SharedConstants + 1464 + (i) * 16)
-#define g_NdcTransform             vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + 1720, 0x10)
+// (at 1720: 8-aligned, not 16; a load declared 16-aligned reads garbage on
+// NVIDIA, and then every vertex lands off screen)
+#define g_NdcTransform             vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + 1720, 8)
 #define g_AlphaFunc                vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 1736)
 #define g_ResolutionScale          vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 1740)
 
