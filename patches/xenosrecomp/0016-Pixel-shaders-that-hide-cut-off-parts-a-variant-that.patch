From bb8020384225523dcd72cec56da55591c511adfc Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Fri, 6 Nov 2026 13:40:09 +0000
Subject: [PATCH] Pixel shaders that hide cut-off parts: a variant that
 interpolates the part id from barycentrics

As Xenia Edge's precise interpolation: TEXCOORD6 read per vertex and
interpolated from the first vertex (exact where the three are equal).
Compiled with -DNG2_BARYCENTRIC (ps_6_1) next to the normal shader, both in
the cache (two new entry fields: the variant's offset and size).
---
 XenosRecomp/dxc_compiler.cpp      |  8 +++++--
 XenosRecomp/dxc_compiler.h        |  3 ++-
 XenosRecomp/main.cpp              | 21 +++++++++++++++++--
 XenosRecomp/shader_recompiler.cpp | 35 ++++++++++++++++++++++++++++++-
 4 files changed, 61 insertions(+), 6 deletions(-)

diff --git a/XenosRecomp/dxc_compiler.cpp b/XenosRecomp/dxc_compiler.cpp
index fcbc43a..c03f4d1 100644
--- a/XenosRecomp/dxc_compiler.cpp
+++ b/XenosRecomp/dxc_compiler.cpp
@@ -11,7 +11,8 @@ DxcCompiler::~DxcCompiler()
     dxcCompiler->Release();
 }
 
-IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv)
+IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv,
+    bool barycentric)
 {
     DxcBuffer source{};
     source.Ptr = shaderSource.c_str();
@@ -29,7 +30,7 @@ IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixe
     else
     {
         if (compilePixelShader)
-            target = L"-T ps_6_0";
+            target = barycentric ? L"-T ps_6_1" : L"-T ps_6_0";  // (GetAttributeAtVertex: 6.1)
         else
             target = L"-T vs_6_0";
     }
@@ -53,6 +54,9 @@ IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixe
     }
 
     args[argCount++] = L"-Qstrip_debug";
+    // The variant that interpolates the part id itself (NG2: SupDel shaders).
+    if (barycentric)
+        args[argCount++] = L"-DNG2_BARYCENTRIC";
 
 #ifdef UNLEASHED_RECOMP
     args[argCount++] = L"-DUNLEASHED_RECOMP";
diff --git a/XenosRecomp/dxc_compiler.h b/XenosRecomp/dxc_compiler.h
index d49bd32..806eea8 100644
--- a/XenosRecomp/dxc_compiler.h
+++ b/XenosRecomp/dxc_compiler.h
@@ -7,5 +7,6 @@ struct DxcCompiler
     DxcCompiler();
     ~DxcCompiler();
 
-    IDxcBlob* compile(const std::string& shaderSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv);
+    IDxcBlob* compile(const std::string& shaderSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv,
+        bool barycentric = false);
 };
diff --git a/XenosRecomp/main.cpp b/XenosRecomp/main.cpp
index 4bf9b5e..aa2ed99 100644
--- a/XenosRecomp/main.cpp
+++ b/XenosRecomp/main.cpp
@@ -26,6 +26,7 @@ struct RecompiledShader
     uint8_t* data = nullptr;
     IDxcBlob* dxil = nullptr;
     std::vector<uint8_t> spirv;
+    std::vector<uint8_t> spirvBarycentric;  // a variant (NG2_BARYCENTRIC), or empty
     uint32_t specConstantsMask = 0;
     uint32_t vertexFetchMask[3] = {};
     uint64_t floatConstantMask[4] = {};
@@ -160,6 +161,21 @@ int main(int argc, char** argv)
 
                 spirv->Release();
 
+                // Shaders with a NG2_BARYCENTRIC variant: compiled again with it
+                // (used where the GPU has fragment shader barycentrics).
+                if (recompiler.snapTexCoord6)
+                {
+                    IDxcBlob* variant = dxcCompiler.compile(recompiler.out, recompiler.isPixelShader, false, true, true);
+                    if (variant == nullptr ||
+                        !smolv::Encode(variant->GetBufferPointer(), variant->GetBufferSize(), shader.spirvBarycentric, smolv::kEncodeFlagStripDebugInfo))
+                    {
+                        fmt::println(stderr, "SPIR-V barycentric variant failed for shader {:016X}", hashShaderPair.first);
+                        failed = true;
+                    }
+                    if (variant != nullptr)
+                        variant->Release();
+                }
+
                 size_t currentProgress = ++progress;
                 if ((currentProgress % 10) == 0 || (currentProgress == shaders.size() - 1))
                     fmt::println("Recompiling shaders... {}%", currentProgress / float(shaders.size()) * 100.0f);
@@ -179,11 +195,11 @@ int main(int argc, char** argv)
 
         for (auto& [hash, shader] : shaders)
         {
-            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {}, {{ 0x{:X}, 0x{:X}, 0x{:X} }}, {{ 0x{:X}, 0x{:X}, 0x{:X}, 0x{:X} }}, 0x{:X} }},",
+            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {}, {{ 0x{:X}, 0x{:X}, 0x{:X} }}, {{ 0x{:X}, 0x{:X}, 0x{:X}, 0x{:X} }}, 0x{:X}, {}, {} }},",
                 hash, dxil.size(), (shader.dxil != nullptr) ? shader.dxil->GetBufferSize() : 0, spirv.size(), shader.spirv.size(), shader.specConstantsMask,
                 shader.vertexFetchMask[0], shader.vertexFetchMask[1], shader.vertexFetchMask[2],
                 shader.floatConstantMask[0], shader.floatConstantMask[1], shader.floatConstantMask[2], shader.floatConstantMask[3],
-                shader.textureSlotMask);
+                shader.textureSlotMask, spirv.size() + shader.spirv.size(), shader.spirvBarycentric.size());
 
             if (shader.dxil != nullptr)
             {
@@ -192,6 +208,7 @@ int main(int argc, char** argv)
             }
             
             spirv.insert(spirv.end(), shader.spirv.begin(), shader.spirv.end());
+            spirv.insert(spirv.end(), shader.spirvBarycentric.begin(), shader.spirvBarycentric.end());
         }
 
         f.println("}};");
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 7836e97..9cc770e 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1487,7 +1487,22 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         out += "\tin float4 iPos : SV_Position,\n";
 
         for (auto& [usage, usageIndex] : INTERPOLATORS)
+        {
+            // The part id of the shaders that hide cut-off parts (SupDel):
+            // in the NG2_BARYCENTRIC variant the three vertices' values,
+            // interpolated in the shader (below).
+            if (snapTexCoord6 && usage == DeclUsage::TexCoord && usageIndex == 6)
+            {
+                out += "#ifdef NG2_BARYCENTRIC\n";
+                out += "\tnointerpolation in float4 iTexCoord6 : TEXCOORD6,\n";
+                out += "\tin float3 iBarycentrics : SV_Barycentrics,\n";
+                out += "#else\n";
+                out += "\tin float4 iTexCoord6 : TEXCOORD6,\n";
+                out += "#endif\n";
+                continue;
+            }
             println("\tin float4 i{0}{1} : {2}{1},", USAGE_VARIABLES[uint32_t(usage)], usageIndex, USAGE_SEMANTICS[uint32_t(usage)]);
+        }
 
         out += "#ifdef __spirv__\n";
         out += "\tin bool iFace : SV_IsFrontFace\n";
@@ -1667,9 +1682,27 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         if (isPixelShader)
         {
             value = reinterpret_cast<const PixelShader*>(shader)->interpolators[i];
-            println("\tfloat4 r{} = i{}{};", uint32_t(interpolator.reg), USAGE_VARIABLES[uint32_t(interpolator.usage)], uint32_t(interpolator.usageIndex));
             if (snapTexCoord6 && interpolator.usage == DeclUsage::TexCoord && interpolator.usageIndex == 6)
+            {
+                // The part id is a whole number at each vertex and compared to
+                // 0.0001: interpolated from the first vertex (as Xenia Edge's
+                // precise interpolation) it is exact where the three are equal.
+                // Without barycentrics, NVIDIA's hardware interpolation is a
+                // hair off there: snapped to the whole number instead.
+                out += "#ifdef NG2_BARYCENTRIC\n";
+                println("\tfloat4 r{} = GetAttributeAtVertex(iTexCoord6, 0) + "
+                    "(GetAttributeAtVertex(iTexCoord6, 1) - GetAttributeAtVertex(iTexCoord6, 0)) * iBarycentrics.y + "
+                    "(GetAttributeAtVertex(iTexCoord6, 2) - GetAttributeAtVertex(iTexCoord6, 0)) * iBarycentrics.z;",
+                    uint32_t(interpolator.reg));
+                out += "#else\n";
+                println("\tfloat4 r{} = iTexCoord6;", uint32_t(interpolator.reg));
                 println("\tr{0}.y = abs(r{0}.y - round(r{0}.y)) < 0.001 ? round(r{0}.y) : r{0}.y;", uint32_t(interpolator.reg));
+                out += "#endif\n";
+            }
+            else
+            {
+                println("\tfloat4 r{} = i{}{};", uint32_t(interpolator.reg), USAGE_VARIABLES[uint32_t(interpolator.usage)], uint32_t(interpolator.usageIndex));
+            }
             printedRegisters[interpolator.reg] = true;
         }
         else
