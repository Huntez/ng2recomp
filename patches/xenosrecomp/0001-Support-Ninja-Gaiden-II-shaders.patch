+uint memExportSwap32(uint v, uint endian)
+{
+    if (endian == 1)
+        return ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+    if (endian == 3)
+        return (v << 16) | (v >> 16);
+    if (endian == 2 || endian == 4 || endian == 5)
+        return (v << 24) | ((v & 0xFF00u) << 8) | ((v >> 8) & 0xFF00u) | (v >> 24);
+    return v;
+}
+
+uint4 memExportSwap(uint4 v, uint endian)
+{
+    v = uint4(memExportSwap32(v.x, endian), memExportSwap32(v.y, endian),
+        memExportSwap32(v.z, endian), memExportSwap32(v.w, endian));
+    if (endian == 4)
+        v = v.yxwz;
+    else if (endian == 5)
+        v = v.wzyx;
+    return v;
+}
+
+// Vertex fetch without a declared element, after Xenia: the fetch constant
+// gives the dword address (dword 0) and endianness (dword 1, bits 0-1).
+uint vfetchLoad(uint byteAddress, uint endian)
+{
+#ifdef __spirv__
+    return memExportSwap32(vk::RawBufferLoad<uint>(g_GuestMemoryBase + byteAddress), endian);
+#else
+    return 0;
+#endif
+}
+
+float4 vfetchNormalize(uint4 c, uint4 widths, bool isSigned, bool isInteger)
+{
+    float4 v;
+    if (isSigned)
+    {
+        int4 shift = 32 - int4(widths);
+        int4 sc = (int4(c) << shift) >> shift;
+        v = float4(sc);
+        if (!isInteger)
+            v = max(v / float4((1u << (widths - 1u)) - 1u), -1.0);
+    }
+    else
+    {
+        v = float4(c);
+        if (!isInteger)
+            v /= float4((1u << widths) - 1u);
+    }
+    return v;
+}
+
+float4 vfetchRaw(float indexValue, uint fetchConstant, uint stride, int offset, uint format,
+    bool isSigned, bool isInteger, int expAdjust, bool isIndexRounded)
+{
+#ifdef __spirv__
+    uint2 constant = g_VertexFetch(fetchConstant);
+#else
+    uint2 constant = 0;
+#endif
+    uint endian = constant.y & 3;
+    int index = int(floor(isIndexRounded ? indexValue + 0.5 : indexValue));
+    uint address = (constant.x & 0xFFFFFFFCu) + uint(index * int(stride) + offset) * 4;
+
+    uint d0 = vfetchLoad(address, endian);
+    // Components a format lacks read as 0 (the fetch swizzle supplies constants).
+    float4 v = 0.0;
+    switch (format)
+    {
+    case 6: // k_8_8_8_8
+        v = vfetchNormalize(uint4(d0, d0 >> 8, d0 >> 16, d0 >> 24) & 0xFF, 8, isSigned, isInteger);
+        break;
+    case 7: // k_2_10_10_10
+        v = vfetchNormalize(uint4(d0 & 0x3FF, (d0 >> 10) & 0x3FF, (d0 >> 20) & 0x3FF, d0 >> 30),
+            uint4(10, 10, 10, 2), isSigned, isInteger);
+        break;
+    case 16: // k_10_11_11
+        v.xyz = vfetchNormalize(uint4(d0 & 0x7FF, (d0 >> 11) & 0x7FF, d0 >> 22, 0),
+            uint4(11, 11, 10, 1), isSigned, isInteger).xyz;
+        break;
+    case 17: // k_11_11_10
+        v.xyz = vfetchNormalize(uint4(d0 & 0x3FF, (d0 >> 10) & 0x7FF, d0 >> 21, 0),
+            uint4(10, 11, 11, 1), isSigned, isInteger).xyz;
+        break;
+    case 25: // k_16_16
+        v.xy = vfetchNormalize(uint4(d0 & 0xFFFF, d0 >> 16, 0, 0), 16, isSigned, isInteger).xy;
+        break;
+    case 26: // k_16_16_16_16
+    {
+        uint d1 = vfetchLoad(address + 4, endian);
+        v = vfetchNormalize(uint4(d0 & 0xFFFF, d0 >> 16, d1 & 0xFFFF, d1 >> 16), 16, isSigned, isInteger);
+        break;
+    }
+    case 31: // k_16_16_FLOAT
+        v.xy = f16tof32(uint2(d0, d0 >> 16));
+        break;
+    case 32: // k_16_16_16_16_FLOAT
+    {
+        uint d1 = vfetchLoad(address + 4, endian);
+        v = f16tof32(uint4(d0, d0 >> 16, d1, d1 >> 16));
+        break;
+    }
+    case 33: // k_32
+        v.x = isSigned ? float(int(d0)) : float(d0);
+        break;
+    case 34: // k_32_32
+        v.xy = isSigned ? float2(int2(d0, vfetchLoad(address + 4, endian))) : float2(d0, vfetchLoad(address + 4, endian));
+        break;
+    case 35: // k_32_32_32_32
+    {
+        uint4 d = uint4(d0, vfetchLoad(address + 4, endian), vfetchLoad(address + 8, endian), vfetchLoad(address + 12, endian));
+        v = isSigned ? float4(int4(d)) : float4(d);
+        break;
+    }
+    case 36: // k_32_FLOAT
+        v.x = asfloat(d0);
+        break;
+    case 37: // k_32_32_FLOAT
+        v.xy = asfloat(uint2(d0, vfetchLoad(address + 4, endian)));
+        break;
+    case 38: // k_32_32_32_32_FLOAT
+        v = asfloat(uint4(d0, vfetchLoad(address + 4, endian), vfetchLoad(address + 8, endian), vfetchLoad(address + 12, endian)));
+        break;
+    case 57: // k_32_32_32_FLOAT
+        v.xyz = asfloat(uint3(d0, vfetchLoad(address + 4, endian), vfetchLoad(address + 8, endian)));
+        break;
+    }
+    return v * exp2(float(expAdjust));
+}
+
+// A fetch of a declared vertex element, set up at draw time from the vertex
+// declaration. Components a format lacks read as (0, 0, 0, 1) like D3D9.
+float4 vfetchElement(float indexValue, uint slot)
+{
+#ifdef __spirv__
+    uint4 element = g_VertexElement(slot);
+#else
+    uint4 element = 0;
+#endif
+    uint flags = element.w;
+    float4 v = vfetchRaw(indexValue, element.x, element.z, int(element.y), flags & 0xFF,
+        (flags & 0x100) != 0, (flags & 0x200) != 0, 0, false);
+    uint format = flags & 0xFF;
+    // Formats with fewer than four components get w = 1.
+    if (format == 36 || format == 37 || format == 57 || format == 25 || format == 31 ||
+        format == 33 || format == 34 || format == 16 || format == 17)
+        v.w = 1.0;
+    if ((flags & 0x800) != 0)
+        v = v.zyxw;
+    return v;
+}
+
+// Memory export (eA/eM#), after Xenia's SPIR-V translator. eA comes from
+// "mad eA, index, const0100, stream constant": x = base in dwords, y = element
+// index, z = format info, w = element count. Elements of 32, 64 and 128 bits
+// are stored; narrower formats would need atomics and are skipped.
+
+// Converts to integers of the given widths (D3D rounding) and masks them.
+uint4 memExportToInt(float4 v, uint4 widths, bool isSigned, bool isNorm)
+{
+    v = select(isnan(v), 0.0, v);
+    uint4 mask = (1u << widths) - 1u;
+    if (isSigned)
+    {
+        float4 maxValue = float4((1u << (widths - 1u)) - 1u);
+        if (isNorm)
+            v = clamp(v, -1.0, 1.0) * maxValue;
+        else
+            v = clamp(v, -maxValue - 1.0, maxValue);
+        return uint4(int4(v + select(v < 0.0, -0.5, 0.5))) & mask;
+    }
+    float4 maxValue = float4(mask);
+    if (isNorm)
+        v = saturate(v) * maxValue;
+    else
+        v = clamp(v, 0.0, maxValue);
+    return uint4(v + 0.5) & mask;
+}
+
+void memExportStore(uint byteAddress, uint dword)
+{
+#ifdef __spirv__
+    vk::RawBufferStore<uint>(g_GuestMemoryBase + byteAddress, dword);
+#endif
+}
+
+void memExport(float4 eA, float4 eM0, float4 eM1, float4 eM2, float4 eM3, float4 eM4, uint written)
+{
+    uint4 address = asuint(eA);
+    if (written == 0 || any((address >> uint4(30, 23, 23, 23)) != uint4(1, 0x96, 0x96, 0x96)))
+        return;
+
+    uint info = address.z;
+    uint format = (info >> 8) & 0x3F;
+    bool isSigned = (info & (1u << 16)) != 0;
+    bool isNorm = (info & (1u << 17)) == 0;
+    bool swapRedBlue = (info & (1u << 19)) != 0;
+    uint endian = info & 7;
+    uint index = address.y & 0x7FFFFF;
+    uint count = address.w & 0x7FFFFF;
+
+    float4 elements[5] = { eM0, eM1, eM2, eM3, eM4 };
+    for (uint i = 0; i < 5; i++)
+    {
+        if ((written & (1u << i)) == 0 || index + i >= count)
+            continue;
+
+        float4 e = swapRedBlue ? elements[i].zyxw : elements[i];
+        uint4 packed = 0;
+        uint dwords = 1;
+        switch (format)
+        {
+        case 6: // k_8_8_8_8
+        case 14: // k_8_8_8_8_A
+        case 50: // k_8_8_8_8_AS_16_16_16_16
+        {
+            uint4 c = memExportToInt(e, 8, isSigned, isNorm);
+            packed.x = c.x | (c.y << 8) | (c.z << 16) | (c.w << 24);
+            break;
+        }
+        case 7: // k_2_10_10_10
+        case 54: // k_2_10_10_10_AS_16_16_16_16
+        {
+            uint4 c = memExportToInt(e, uint4(10, 10, 10, 2), isSigned, isNorm);
+            packed.x = c.x | (c.y << 10) | (c.z << 20) | (c.w << 30);
+            break;
+        }
+        case 16: // k_10_11_11
+        case 55: // k_10_11_11_AS_16_16_16_16
+        {
+            uint4 c = memExportToInt(e, uint4(11, 11, 10, 1), isSigned, isNorm);
+            packed.x = c.x | (c.y << 11) | (c.z << 22);
+            break;
+        }
+        case 17: // k_11_11_10
+        case 56: // k_11_11_10_AS_16_16_16_16
+        {
+            uint4 c = memExportToInt(e, uint4(10, 11, 11, 1), isSigned, isNorm);
+            packed.x = c.x | (c.y << 10) | (c.z << 21);
+            break;
+        }
+        case 25: // k_16_16
+        {
+            uint4 c = memExportToInt(e, 16, isSigned, isNorm);
+            packed.x = c.x | (c.y << 16);
+            break;
+        }
+        case 26: // k_16_16_16_16
+        {
+            uint4 c = memExportToInt(e, 16, isSigned, isNorm);
+            packed.xy = c.xz | (c.yw << 16);
+            dwords = 2;
+            break;
+        }
+        case 31: // k_16_16_FLOAT
+            packed.x = f32tof16(e.x) | (f32tof16(e.y) << 16);
+            break;
+        case 32: // k_16_16_16_16_FLOAT
+            packed.xy = f32tof16(e.xz) | (f32tof16(e.yw) << 16);
+            dwords = 2;
+            break;
+        case 36: // k_32_FLOAT
+            packed.x = asuint(e.x);
+            break;
+        case 37: // k_32_32_FLOAT
+            packed.xy = asuint(e.xy);
+            dwords = 2;
+            break;
+        case 38: // k_32_32_32_32_FLOAT
+            packed = asuint(e);
+            dwords = 4;
+            break;
+        default:
+            return;
+        }
+
+        packed = memExportSwap(packed, endian);
+        uint byteAddress = (address.x << 2) + (index + i) * dwords * 4;
+        for (uint j = 0; j < dwords; j++)
+            memExportStore(byteAddress + j * 4, packed[j]);
+    }
+}
+
 #endif
 
 #endif
