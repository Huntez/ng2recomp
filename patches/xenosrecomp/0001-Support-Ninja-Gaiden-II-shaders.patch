+#define g_GuestMemoryBase          vk::RawBufferLoad<uint64_t>(g_PushConstants.SharedConstants + 688, 8)
+#define g_VertexFetch(i)           vk::RawBufferLoad<uint2>(g_PushConstants.SharedConstants + 696 + (i) * 8)
+#define g_VertexElement(i)         vk::RawBufferLoad<uint4>(g_PushConstants.SharedConstants + 1464 + (i) * 16)
