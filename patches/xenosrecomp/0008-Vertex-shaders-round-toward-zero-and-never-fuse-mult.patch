From d5fbc1305a83b10245132b170892d09d6a0cfe85 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sat, 31 Oct 2026 17:53:24 +0000
Subject: [PATCH] Vertex shaders round toward zero and never fuse multiply-adds

---
 XenosRecomp/shader_recompiler.cpp | 41 ++++++++++++++++++++++++++-----
 1 file changed, 35 insertions(+), 6 deletions(-)

diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index ef9b60c..76cb67f 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1418,6 +1418,22 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
 
     out += "#endif\n";
 
+    // Xenos vertex ALUs round sums and products toward zero and never fuse a
+    // multiply and an add (Xenia Edge 3390fc219, 043a7cb40): games split
+    // vertex and bone indices with mul then trunc, which round to nearest
+    // can push into the next one. Vertex shaders get SPIR-V's RoundingModeRTZ
+    // (dropped at runtime where the GPU lacks it) and precise registers.
+    // DXC only declares the capability for an instruction that asks for it.
+    if (!isPixelShader)
+    {
+        out += "#ifdef __spirv__\n";
+        out += "[[vk::ext_capability(/* RoundingModeRTZ */ 4468)]]\n";
+        out += "[[vk::ext_extension(\"SPV_KHR_float_controls\")]]\n";
+        out += "[[vk::ext_instruction(/* OpFAdd */ 129)]]\n";
+        out += "float RoundTowardZeroAdd(float a, float b);\n";
+        out += "#endif\n";
+    }
+
     out += "void main(\n";
 
     if (isPixelShader)
@@ -1513,14 +1529,20 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         out += "\tin uint iVertexId : SV_VertexID,\n";
     #endif
 
-        out += "\tout float4 oPos : SV_Position";
+        out += "\tprecise out float4 oPos : SV_Position";
 
         for (auto& [usage, usageIndex] : INTERPOLATORS)
-            print(",\n\tout float4 o{0}{1} : {2}{1}", USAGE_VARIABLES[uint32_t(usage)], usageIndex, USAGE_SEMANTICS[uint32_t(usage)]);
+            print(",\n\tprecise out float4 o{0}{1} : {2}{1}", USAGE_VARIABLES[uint32_t(usage)], usageIndex, USAGE_SEMANTICS[uint32_t(usage)]);
     }
 
     out += ")\n";
     out += "{\n";
+    if (!isPixelShader)
+    {
+        out += "#ifdef __spirv__\n";
+        out += "\tvk::ext_execution_mode(/* RoundingModeRTZ */ 4463, 32);\n";
+        out += "#endif\n";
+    }
 
 #ifdef UNLEASHED_RECOMP
     if (hasMtxProjection)
@@ -1627,7 +1649,7 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     {
         if (!printedRegisters[i])
         {
-            print("\tfloat4 r{} = ", i);
+            print("\t{}float4 r{} = ", isPixelShader ? "" : "precise ", i);
             if (isPixelShader && i == ((shader->fieldC >> 8) & 0xFF))
             {
                 out += "float4((iPos.xy - 0.5) / g_ResolutionScale * float2(iFace ? 1.0 : -1.0, 1.0), 0.0, 0.0);\n";
@@ -1654,11 +1676,18 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     out += "\tint a0 = 0;\n";
     out += "\tint aL = 0;\n";
     out += "\tbool p0 = false;\n";
-    out += "\tfloat4 eA = 0.0;\n";
-    out += "\tfloat4 eM0 = 0.0, eM1 = 0.0, eM2 = 0.0, eM3 = 0.0, eM4 = 0.0;\n";
+    const char* precise = isPixelShader ? "" : "precise ";
+    println("\t{}float4 eA = 0.0;", precise);
+    println("\t{}float4 eM0 = 0.0, eM1 = 0.0, eM2 = 0.0, eM3 = 0.0, eM4 = 0.0;", precise);
     out += "\tuint eMWritten = 0;\n";
     out += "\tfloat vfetchIndex = 0.0;\n";
-    out += "\tfloat ps = 0.0;\n";
+    println("\t{}float ps = 0.0;", precise);
+    if (!isPixelShader)
+    {
+        out += "#ifdef __spirv__\n";
+        out += "\tps = RoundTowardZeroAdd(ps, 0.0);\n";
+        out += "#endif\n";
+    }
     if (isPixelShader)
     {
 #ifdef UNLEASHED_RECOMP
-- 
2.56.0

