From cef961c334a2e7651bb39f14247723a51f7d1fd1 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 18:23:47 +0000
Subject: [PATCH] Record the vertex fetch constants each shader reads raw

The cache entry gets a 96-bit mask, so the host uploads only the vertex
data a shader can read.
---
 XenosRecomp/main.cpp              | 8 ++++++--
 XenosRecomp/shader_recompiler.cpp | 3 +++
 XenosRecomp/shader_recompiler.h   | 3 +++
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/XenosRecomp/main.cpp b/XenosRecomp/main.cpp
index 3d16fc4..566ca3a 100644
--- a/XenosRecomp/main.cpp
+++ b/XenosRecomp/main.cpp
@@ -27,6 +27,7 @@ struct RecompiledShader
     IDxcBlob* dxil = nullptr;
     std::vector<uint8_t> spirv;
     uint32_t specConstantsMask = 0;
+    uint32_t vertexFetchMask[3] = {};
 };
 
 int main(int argc, char** argv)
@@ -125,6 +126,8 @@ int main(int argc, char** argv)
                 recompiler.recompile(shader.data, include);
 
                 shader.specConstantsMask = recompiler.specConstantsMask;
+                std::copy(std::begin(recompiler.vertexFetchMask), std::end(recompiler.vertexFetchMask),
+                    shader.vertexFetchMask);
 
                 thread_local DxcCompiler dxcCompiler;
 
@@ -171,8 +174,9 @@ int main(int argc, char** argv)
 
         for (auto& [hash, shader] : shaders)
         {
-            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {} }},",
-                hash, dxil.size(), (shader.dxil != nullptr) ? shader.dxil->GetBufferSize() : 0, spirv.size(), shader.spirv.size(), shader.specConstantsMask);
+            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {}, {{ 0x{:X}, 0x{:X}, 0x{:X} }} }},",
+                hash, dxil.size(), (shader.dxil != nullptr) ? shader.dxil->GetBufferSize() : 0, spirv.size(), shader.spirv.size(), shader.specConstantsMask,
+                shader.vertexFetchMask[0], shader.vertexFetchMask[1], shader.vertexFetchMask[2]);
 
             if (shader.dxil != nullptr)
             {
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 21a0bd6..c8149e5 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -240,6 +240,9 @@ void ShaderRecompiler::recompile(const VertexFetchInstruction& instr, uint32_t a
         // Mini fetches reuse the previous full fetch's constant, stride and
         // latched index.
         const auto& full = lastFullVertexFetch;
+        uint32_t fetchSlot = full.constIndex * 3 + full.constIndexSelect;
+        if (fetchSlot < 96)
+            vertexFetchMask[fetchSlot / 32] |= 1u << (fetchSlot % 32);
         print("vfetchRaw(vfetchIndex, {}, {}, {}, {}, {}, {}, {}, {}).",
             full.constIndex * 3 + full.constIndexSelect, uint32_t(full.stride), int32_t(instr.offset),
             uint32_t(instr.format), instr.formatCompAll ? "true" : "false", instr.numFormatAll ? "true" : "false",
diff --git a/XenosRecomp/shader_recompiler.h b/XenosRecomp/shader_recompiler.h
index 7998935..cbbc175 100644
--- a/XenosRecomp/shader_recompiler.h
+++ b/XenosRecomp/shader_recompiler.h
@@ -33,6 +33,9 @@ struct ShaderRecompiler : StringBuffer
     std::unordered_map<uint32_t, const char*> samplers;
     std::unordered_map<uint32_t, uint32_t> ifEndLabels;
     uint32_t specConstantsMask = 0;
+    // Vertex fetch constants (0-95) read through vfetchRaw, so the host can
+    // upload only the vertex data a shader reads.
+    uint32_t vertexFetchMask[3] = {};
     bool hasMemExport = false;
     VertexFetchInstruction lastFullVertexFetch{};
     std::unordered_map<uint32_t, uint32_t> declaredElementSlots;
-- 
2.56.0

