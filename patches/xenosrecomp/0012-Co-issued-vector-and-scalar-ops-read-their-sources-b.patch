From 4b6a6661e96de1f8bef1d07fa64051107895f906 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 5 Nov 2026 15:33:56 +0000
Subject: [PATCH] Co-issued vector and scalar ops read their sources before
 either writes

A vector op's result to a temp register is held while the scalar op of the
same instruction reads its sources, then written, before the scalar result
(Xenos reads both ops' sources first; mul r0.xyz with sgts r1, r0.x read the
new r0.x).
---
 XenosRecomp/shader_recompiler.cpp | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 290cb9a..b711969 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -814,10 +814,20 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
     if (instr.exportData)
         vectorWriteMask &= ~instr.scalarWriteMask;
 
+    // With a scalar op in the same instruction, a temp register's vector
+    // result is held and written after the scalar op has read its sources
+    // (below, before the scalar result is written, as before).
+    const bool holdVector = vectorWriteMask != 0 && exportRegister.empty() &&
+        instr.scalarOpcode != AluScalarOpcode::RetainPrev;
+
     if (vectorWriteMask != 0)
     {
         indent();
-        if (!exportRegister.empty())
+        if (holdVector)
+        {
+            out += "vectorResult.";
+        }
+        else if (!exportRegister.empty())
         {
             out += exportRegister;
             out += '.';
@@ -1181,6 +1191,18 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
         }
     }
 
+    if (holdVector)
+    {
+        std::string mask;
+        for (size_t i = 0; i < 4; i++)
+        {
+            if ((vectorWriteMask >> i) & 0x1)
+                mask += SWIZZLES[i];
+        }
+        indent();
+        println("r{}.{} = vectorResult.{};", instr.vectorDest, mask, mask);
+    }
+
     uint32_t scalarWriteMask = instr.scalarWriteMask;
     if (instr.exportData)
         scalarWriteMask &= ~instr.vectorWriteMask;
@@ -1703,6 +1725,9 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     out += "\tuint eMWritten = 0;\n";
     out += "\tfloat vfetchIndex = 0.0;\n";
     println("\t{}float ps = 0.0;", precise);
+    // A vector result held while the scalar op of the same instruction reads
+    // its sources (Xenos reads both ops' sources before writing either).
+    println("\t{}float4 vectorResult = 0.0;", precise);
     if (!isPixelShader)
     {
         out += "#ifdef __spirv__\n";
-- 
