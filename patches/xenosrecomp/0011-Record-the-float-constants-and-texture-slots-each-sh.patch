From 5a192fcd39e4bc1a6978780f4eb56eddb66e6eb1 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Tue, 3 Nov 2026 15:36:13 +0000
Subject: [PATCH] Record the float constants and texture slots each shader
 reads

floatConstantMask (registers 0-255; relative addressing marks the whole
file) and textureSlotMask (tfetch and getWeights slots) go into the shader
cache, so the host uploads and binds only those. The cache defines
g_shaderCacheHasMasks so an older one fails to link.
---
 XenosRecomp/main.cpp              | 13 +++++++++++--
 XenosRecomp/shader_recompiler.cpp | 13 +++++++++++++
 XenosRecomp/shader_recompiler.h   |  4 ++++
 3 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/XenosRecomp/main.cpp b/XenosRecomp/main.cpp
index 566ca3a..4bf9b5e 100644
--- a/XenosRecomp/main.cpp
+++ b/XenosRecomp/main.cpp
@@ -28,6 +28,8 @@ struct RecompiledShader
     std::vector<uint8_t> spirv;
     uint32_t specConstantsMask = 0;
     uint32_t vertexFetchMask[3] = {};
+    uint64_t floatConstantMask[4] = {};
+    uint32_t textureSlotMask = 0;
 };
 
 int main(int argc, char** argv)
@@ -128,6 +130,9 @@ int main(int argc, char** argv)
                 shader.specConstantsMask = recompiler.specConstantsMask;
                 std::copy(std::begin(recompiler.vertexFetchMask), std::end(recompiler.vertexFetchMask),
                     shader.vertexFetchMask);
+                std::copy(std::begin(recompiler.floatConstantMask), std::end(recompiler.floatConstantMask),
+                    shader.floatConstantMask);
+                shader.textureSlotMask = recompiler.textureSlotMask;
 
                 thread_local DxcCompiler dxcCompiler;
 
@@ -174,9 +179,11 @@ int main(int argc, char** argv)
 
         for (auto& [hash, shader] : shaders)
         {
-            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {}, {{ 0x{:X}, 0x{:X}, 0x{:X} }} }},",
+            f.println("\t{{ 0x{:X}, {}, {}, {}, {}, {}, {{ 0x{:X}, 0x{:X}, 0x{:X} }}, {{ 0x{:X}, 0x{:X}, 0x{:X}, 0x{:X} }}, 0x{:X} }},",
                 hash, dxil.size(), (shader.dxil != nullptr) ? shader.dxil->GetBufferSize() : 0, spirv.size(), shader.spirv.size(), shader.specConstantsMask,
-                shader.vertexFetchMask[0], shader.vertexFetchMask[1], shader.vertexFetchMask[2]);
+                shader.vertexFetchMask[0], shader.vertexFetchMask[1], shader.vertexFetchMask[2],
+                shader.floatConstantMask[0], shader.floatConstantMask[1], shader.floatConstantMask[2], shader.floatConstantMask[3],
+                shader.textureSlotMask);
 
             if (shader.dxil != nullptr)
             {
@@ -222,6 +229,8 @@ int main(int argc, char** argv)
         f.println("const size_t g_spirvCacheCompressedSize = {};", spirvCompressed.size());
         f.println("const size_t g_spirvCacheDecompressedSize = {};", spirv.size());
         f.println("const size_t g_shaderCacheEntryCount = {};", shaders.size());
+        // A cache from before the masks would leave them zero: the renderer links against this.
+        f.println("extern const int g_shaderCacheHasMasks = 1;");
 
         writeAllBytes(output, f.out.data(), f.out.size());
     }
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index d3c1d3c..290cb9a 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -309,6 +309,8 @@ void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicu
     if (instr.opcode != FetchOpcode::TextureFetch && instr.opcode != FetchOpcode::GetTextureWeights)
         return;
 
+    textureSlotMask |= 1u << (instr.constIndex & 31);
+
     if (instr.isPredicated)
     {
         indent();
@@ -583,6 +585,17 @@ void ShaderRecompiler::recompile(const AluInstruction& instr)
                 auto findResult = float4Constants.find(reg);
                 if (findResult != float4Constants.end())
                 {
+                    // The registers the host must upload: this one, or with relative addressing
+                    // the whole file (the define clamps the top only; a0 can be negative).
+                    uint32_t first = reg, last = reg;
+                    if (constRelative && findResult->second->registerCount > 1)
+                    {
+                        first = 0;
+                        last = (isPixelShader ? 224 : 256) - 1;
+                    }
+                    for (uint32_t r = first; r <= last && r < 256; r++)
+                        floatConstantMask[r / 64] |= 1ull << (r % 64);
+
                     const char* constantName = reinterpret_cast<const char*>(constantTableData + findResult->second->name);
                     if (findResult->second->registerCount > 1)
                     {
diff --git a/XenosRecomp/shader_recompiler.h b/XenosRecomp/shader_recompiler.h
index cbbc175..a1ce0fc 100644
--- a/XenosRecomp/shader_recompiler.h
+++ b/XenosRecomp/shader_recompiler.h
@@ -36,6 +36,10 @@ struct ShaderRecompiler : StringBuffer
     // Vertex fetch constants (0-95) read through vfetchRaw, so the host can
     // upload only the vertex data a shader reads.
     uint32_t vertexFetchMask[3] = {};
+    // Float constant registers (0-255) read from the host's constant buffer, and
+    // the texture fetch slots (0-31) sampled: the host uploads and binds only these.
+    uint64_t floatConstantMask[4] = {};
+    uint32_t textureSlotMask = 0;
     bool hasMemExport = false;
     VertexFetchInstruction lastFullVertexFetch{};
     std::unordered_map<uint32_t, uint32_t> declaredElementSlots;
-- 
