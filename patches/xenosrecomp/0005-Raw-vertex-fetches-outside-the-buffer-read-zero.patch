From 3411e68675134b7d7667d65252688568a0387107 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 29 Oct 2026 00:03:00 +0000
Subject: [PATCH] Raw vertex fetches outside the buffer read zero

The fetch constant's size (dwords, bits 2-25) bounds the fetch; out of
range it read whatever memory followed, which drew stray vertices.
---
 XenosRecomp/shader_common.h | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 2699e79..0d4324c 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -342,7 +342,14 @@ float4 vfetchRaw(float indexValue, uint fetchConstant, uint stride, int offset,
 #endif
     uint endian = constant.y & 3;
     int index = int(floor(isIndexRounded ? indexValue + 0.5 : indexValue));
-    uint address = (constant.x & 0xFFFFFFFCu) + uint(index * int(stride) + offset) * 4;
+    int position = index * int(stride) + offset;  // in dwords from the buffer start
+    uint address = (constant.x & 0xFFFFFFFCu) + uint(position) * 4;
+    // Outside the buffer the fetch constant describes (size in dwords, bits
+    // 2-25): zero, instead of whatever memory lies there (a stray vertex
+    // collapses rather than flying off).
+    uint size = (constant.y >> 2) & 0xFFFFFFu;
+    if (position < 0 || uint(position) >= size)
+        return 0.0;
 
     uint d0 = vfetchLoad(address, endian);
     // Components a format lacks read as 0 (the fetch swizzle supplies constants).
