From de89b6cd427ce56a5a2342092522c3d2f5a96ada Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Wed, 28 Oct 2026 21:38:40 +0000
Subject: [PATCH] Wrap guest memory addresses at 512 MB

A vertex fetch with a garbage index read past the guest memory buffer,
which faulted the GPU and hung the queue.
---
 XenosRecomp/shader_common.h | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index ba90b4c..bccf11c 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -273,10 +273,16 @@ uint4 memExportSwap(uint4 v, uint endian)
 
 // Vertex fetch without a declared element, after Xenia: the fetch constant
 // gives the dword address (dword 0) and endianness (dword 1, bits 0-1).
+// Guest physical memory is 512 MB; addresses wrap like the console's, which
+// also keeps a garbage index (an unused stream, NaN) inside the buffer
+// instead of faulting the GPU.
+#define GUEST_MEMORY_MASK 0x1FFFFFFCu
+
 uint vfetchLoad(uint byteAddress, uint endian)
 {
 #ifdef __spirv__
-    return memExportSwap32(vk::RawBufferLoad<uint>(g_GuestMemoryBase + byteAddress), endian);
+    return memExportSwap32(
+        vk::RawBufferLoad<uint>(g_GuestMemoryBase + (byteAddress & GUEST_MEMORY_MASK)), endian);
 #else
     return 0;
 #endif
@@ -432,7 +438,7 @@ uint4 memExportToInt(float4 v, uint4 widths, bool isSigned, bool isNorm)
 void memExportStore(uint byteAddress, uint dword)
 {
 #ifdef __spirv__
-    vk::RawBufferStore<uint>(g_GuestMemoryBase + byteAddress, dword);
+    vk::RawBufferStore<uint>(g_GuestMemoryBase + (byteAddress & GUEST_MEMORY_MASK), dword);
 #endif
 }
 
