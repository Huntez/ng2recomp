From c2b1e35ff683da6e15d7924ce6834b030ed6c3f3 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Fri, 6 Nov 2026 13:40:16 +0000
Subject: [PATCH] Capabilities: fragmentShaderBarycentric
 (VK_KHR_fragment_shader_barycentric, enabled where supported)

---
 plume_render_interface_types.h |  2 ++
 plume_vulkan.cpp               | 14 ++++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index fd5a014..c4e31df 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -1928,6 +1928,8 @@ namespace plume {
 
         // Shaders may round 32-bit float math toward zero (SPIR-V RoundingModeRTZ).
         bool roundingModeRTZ = false;
+        // VK_KHR_fragment_shader_barycentric (SPIR-V PerVertexKHR inputs, BaryCoordKHR).
+        bool fragmentShaderBarycentric = false;
     };
 
     struct RenderInterfaceCapabilities {
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index 1f1154b..85d5216 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -87,6 +87,7 @@ namespace plume {
         VK_KHR_PRESENT_ID_EXTENSION_NAME,
         VK_KHR_PRESENT_WAIT_EXTENSION_NAME,
         VK_GOOGLE_DISPLAY_TIMING_EXTENSION_NAME,
+        VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME,
         // Vulkan spec requires this to be enabled if supported by the driver.
         VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME,
     };
@@ -3990,6 +3991,13 @@ namespace plume {
         portabilityFeatures.pNext = featuresChain;
         featuresChain = &portabilityFeatures;
 
+        VkPhysicalDeviceFragmentShaderBarycentricFeaturesKHR barycentricFeatures = {};
+        barycentricFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_BARYCENTRIC_FEATURES_KHR;
+        if (supportedOptionalExtensions.find(VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME) != supportedOptionalExtensions.end()) {
+            barycentricFeatures.pNext = featuresChain;
+            featuresChain = &barycentricFeatures;
+        }
+
         VkPhysicalDeviceFeatures2 deviceFeatures = {};
         deviceFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
         deviceFeatures.pNext = featuresChain;
@@ -4048,6 +4056,12 @@ namespace plume {
             createDeviceChain = &presentWaitFeatures;
         }
 
+        capabilities.fragmentShaderBarycentric = barycentricFeatures.fragmentShaderBarycentric;
+        if (capabilities.fragmentShaderBarycentric) {
+            barycentricFeatures.pNext = createDeviceChain;
+            createDeviceChain = &barycentricFeatures;
+        }
+
         const bool nullDescriptor = robustnessFeatures.nullDescriptor;
         if (nullDescriptor) {
             robustnessFeatures.pNext = createDeviceChain;
-- 
2.56.0

