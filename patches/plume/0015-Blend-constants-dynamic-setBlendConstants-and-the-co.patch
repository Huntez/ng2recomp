From 54ae1d50403642c3670f8f92fa28669695645edc Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 15:45:24 +0000
Subject: [PATCH] Blend constants: dynamic (setBlendConstants), and the
 constant-alpha factors

Pipelines made with dynamicBlendConstantsEnabled take VK_DYNAMIC_STATE_BLEND_CONSTANTS, set with setBlendConstants on the command list (Vulkan; a no-op elsewhere). RenderBlend gains BLEND_FACTOR_ALPHA and INV_BLEND_FACTOR_ALPHA (VK_BLEND_FACTOR_CONSTANT_ALPHA and its inverse).
---
 plume_render_interface.h       |  2 ++
 plume_render_interface_types.h |  5 ++++-
 plume_vulkan.cpp               | 12 ++++++++++++
 plume_vulkan.h                 |  1 +
 4 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/plume_render_interface.h b/plume_render_interface.h
index 6921766..c1e3754 100644
--- a/plume_render_interface.h
+++ b/plume_render_interface.h
@@ -156,6 +156,8 @@ namespace plume {
         virtual void setScissors(const RenderRect *scissorRects, uint32_t count) = 0;
         virtual void setFramebuffer(const RenderFramebuffer *framebuffer) = 0;
         virtual void setDepthBias(float depthBias, float depthBiasClamp, float slopeScaledDepthBias) = 0;
+        // For pipelines made with dynamicBlendConstantsEnabled (Vulkan only).
+        virtual void setBlendConstants(const float constants[4]) { (void)constants; }
         virtual void clearColor(uint32_t attachmentIndex = 0, RenderColor colorValue = RenderColor(), const RenderRect *clearRects = nullptr, uint32_t clearRectsCount = 0) = 0;
         virtual void clearDepthStencil(bool clearDepth = true, bool clearStencil = true, float depthValue = 1.0f, uint32_t stencilValue = 0, const RenderRect *clearRects = nullptr, uint32_t clearRectsCount = 0) = 0;
         virtual void copyBufferRegion(RenderBufferReference dstBuffer, RenderBufferReference srcBuffer, uint64_t size) = 0;
diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index baec343..fce0ceb 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -284,7 +284,9 @@ namespace plume {
         SRC1_COLOR,
         INV_SRC1_COLOR,
         SRC1_ALPHA,
-        INV_SRC1_ALPHA
+        INV_SRC1_ALPHA,
+        BLEND_FACTOR_ALPHA,
+        INV_BLEND_FACTOR_ALPHA
     };
 
     enum class RenderBlendOperation {
@@ -1289,6 +1291,7 @@ namespace plume {
         float depthBiasClamp = 0.0f;
         float slopeScaledDepthBias = 0.0f;
         bool dynamicDepthBiasEnabled = false;
+        bool dynamicBlendConstantsEnabled = false;
         bool depthEnabled = false;
         bool depthWriteEnabled = false;
         bool stencilEnabled = false;
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index c4f43e8..2c3735e 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -384,6 +384,10 @@ namespace plume {
             return VK_BLEND_FACTOR_SRC1_ALPHA;
         case RenderBlend::INV_SRC1_ALPHA:
             return VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA;
+        case RenderBlend::BLEND_FACTOR_ALPHA:
+            return VK_BLEND_FACTOR_CONSTANT_ALPHA;
+        case RenderBlend::INV_BLEND_FACTOR_ALPHA:
+            return VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA;
         default:
             assert(false && "Unknown blend factor.");
             return VK_BLEND_FACTOR_MAX_ENUM;
@@ -1645,6 +1649,10 @@ namespace plume {
             dynamicStates.emplace_back(VK_DYNAMIC_STATE_DEPTH_BIAS);
         }
 
+        if (desc.dynamicBlendConstantsEnabled) {
+            dynamicStates.emplace_back(VK_DYNAMIC_STATE_BLEND_CONSTANTS);
+        }
+
         VkPipelineDynamicStateCreateInfo dynamicState = {};
         dynamicState.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
         dynamicState.pDynamicStates = dynamicStates.data();
@@ -3289,6 +3297,10 @@ namespace plume {
         vkCmdSetDepthBias(vk, depthBias, depthBiasClamp, slopeScaledDepthBias);
     }
 
+    void VulkanCommandList::setBlendConstants(const float constants[4]) {
+        vkCmdSetBlendConstants(vk, constants);
+    }
+
     static void clearCommonRectVector(uint32_t width, uint32_t height, const RenderRect *clearRects, uint32_t clearRectsCount, std::vector<VkClearRect> &rectVector) {
         rectVector.clear();
 
diff --git a/plume_vulkan.h b/plume_vulkan.h
index 2aa9163..3c48e91 100644
--- a/plume_vulkan.h
+++ b/plume_vulkan.h
@@ -341,6 +341,7 @@ namespace plume {
         void setScissors(const RenderRect *scissorRects, uint32_t count) override;
         void setFramebuffer(const RenderFramebuffer *framebuffer) override;
         void setDepthBias(float depthBias, float depthBiasClamp, float slopeScaledDepthBias) override;
+        void setBlendConstants(const float constants[4]) override;
         void clearColor(uint32_t attachmentIndex, RenderColor colorValue, const RenderRect *clearRects, uint32_t clearRectsCount) override;
         void clearDepthStencil(bool clearDepth, bool clearStencil, float depthValue, uint32_t stencilValue, const RenderRect *clearRects, uint32_t clearRectsCount) override;
         void copyBufferRegion(RenderBufferReference dstBuffer, RenderBufferReference srcBuffer, uint64_t size) override;
-- 
2.56.0

