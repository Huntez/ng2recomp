From 6f7641cba06fabda030fe58cef5b8121118d86b8 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 5 Nov 2026 18:11:57 +0000
Subject: [PATCH] Query pool: results of the first queries only (count), so
 unwritten ones don't fail the read

vkGetQueryPoolResults over the whole pool returns VK_NOT_READY while any
query is unwritten, and then the timestamps aren't converted to nanoseconds.
---
 plume_d3d12.cpp          |  2 +-
 plume_d3d12.h            |  2 +-
 plume_render_interface.h |  4 +++-
 plume_vulkan.cpp         | 10 +++++++---
 plume_vulkan.h           |  2 +-
 5 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/plume_d3d12.cpp b/plume_d3d12.cpp
index e3241c1..1a0844a 100644
--- a/plume_d3d12.cpp
+++ b/plume_d3d12.cpp
@@ -1791,7 +1791,7 @@ namespace plume {
         }
     }
 
-    void D3D12QueryPool::queryResults() {
+    void D3D12QueryPool::queryResults(uint32_t) {
         void *readbackData = readbackBuffer->map();
         memcpy(results.data(), readbackData, sizeof(uint64_t) * results.size());
         readbackBuffer->unmap();
diff --git a/plume_d3d12.h b/plume_d3d12.h
index 8200507..bf614a0 100644
--- a/plume_d3d12.h
+++ b/plume_d3d12.h
@@ -162,7 +162,7 @@ namespace plume {
 
         D3D12QueryPool(D3D12Device *device, uint32_t queryCount);
         virtual ~D3D12QueryPool() override;
-        virtual void queryResults() override;
+        virtual void queryResults(uint32_t count = 0) override;
         virtual const uint64_t *getResults() const override;
         virtual uint32_t getCount() const override;
     };
diff --git a/plume_render_interface.h b/plume_render_interface.h
index 654e48b..584b343 100644
--- a/plume_render_interface.h
+++ b/plume_render_interface.h
@@ -232,7 +232,9 @@ namespace plume {
 
     struct RenderQueryPool {
         virtual ~RenderQueryPool() { }
-        virtual void queryResults() = 0;
+        // count: only the first queries (0: all), so unwritten ones at the
+        // end don't make the call fail.
+        virtual void queryResults(uint32_t count = 0) = 0;
         virtual const uint64_t *getResults() const = 0;
         virtual uint32_t getCount() const = 0;
     };
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index 3fdc3db..ae15e98 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -2756,8 +2756,11 @@ namespace plume {
         vkDestroyQueryPool(device->vk, vk, nullptr);
     }
 
-    void VulkanQueryPool::queryResults() {
-	    VkResult res = vkGetQueryPoolResults(device->vk, vk, 0, uint32_t(results.size()), sizeof(uint64_t) * results.size(), results.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+    void VulkanQueryPool::queryResults(uint32_t count) {
+        if (count == 0 || count > results.size()) {
+            count = uint32_t(results.size());
+        }
+	    VkResult res = vkGetQueryPoolResults(device->vk, vk, 0, count, sizeof(uint64_t) * count, results.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
         if (res != VK_SUCCESS) {
             fprintf(stderr, "vkGetQueryPoolResults failed with error code 0x%X.\n", res);
             return;
@@ -2788,7 +2791,8 @@ namespace plume {
         constexpr uint64_t shift_bits = 16;
         double timestampPeriod = double(device->physicalDeviceProperties.limits.timestampPeriod);
         uint64_t h = 0, l = 0;
-        for (uint64_t &result : results) {
+        for (uint32_t i = 0; i < count; i++) {
+            uint64_t &result = results[i];
             mult64to128(result, uint64_t(timestampPeriod * double(1 << shift_bits)), h, l);
             result = l;
             result >>= shift_bits;
diff --git a/plume_vulkan.h b/plume_vulkan.h
index fecf079..d66f37d 100644
--- a/plume_vulkan.h
+++ b/plume_vulkan.h
@@ -298,7 +298,7 @@ namespace plume {
 
         VulkanQueryPool(VulkanDevice *device, uint32_t queryCount);
         virtual ~VulkanQueryPool() override;
-        virtual void queryResults() override;
+        virtual void queryResults(uint32_t count = 0) override;
         virtual const uint64_t *getResults() const override;
         virtual uint32_t getCount() const override;
     };
-- 
2.56.0

