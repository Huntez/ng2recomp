From 32d32b2958a1c532178b7a92a7d23c7128277d11 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 21:50:58 +0000
Subject: [PATCH] Formats: B5G6R5_UNORM

The guest's 5_6_5 textures, as Xenia hosts them (VK_FORMAT_R5G6B5_UNORM_PACK16,
DXGI_FORMAT_B5G6R5_UNORM: blue in the low bits; the port swaps red and blue at
upload). Last in the enum, so the other formats keep their values.
---
 plume_d3d12.cpp                | 2 ++
 plume_render_interface_types.h | 3 +++
 plume_vulkan.cpp               | 2 ++
 3 files changed, 7 insertions(+)

diff --git a/plume_d3d12.cpp b/plume_d3d12.cpp
index d4ea203..4136202 100644
--- a/plume_d3d12.cpp
+++ b/plume_d3d12.cpp
@@ -120,6 +120,8 @@ namespace plume {
             return DXGI_FORMAT_R8G8B8A8_SINT;
         case RenderFormat::R10G10B10A2_UNORM:
             return DXGI_FORMAT_R10G10B10A2_UNORM;
+        case RenderFormat::B5G6R5_UNORM:
+            return DXGI_FORMAT_B5G6R5_UNORM;
         case RenderFormat::B8G8R8A8_UNORM:
             return DXGI_FORMAT_B8G8R8A8_UNORM;
         case RenderFormat::R16G16_TYPELESS:
diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index fce0ceb..9024bea 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -178,6 +178,7 @@ namespace plume {
         BC7_UNORM,
         BC7_UNORM_SRGB,
         R10G10B10A2_UNORM,
+        B5G6R5_UNORM,
         MAX
     };
 
@@ -594,6 +595,7 @@ namespace plume {
         case RenderFormat::R16_UINT:
         case RenderFormat::R16_SNORM:
         case RenderFormat::R16_SINT:
+        case RenderFormat::B5G6R5_UNORM:
             return 2;
         case RenderFormat::R8_TYPELESS:
         case RenderFormat::R8_UNORM:
@@ -678,6 +680,7 @@ namespace plume {
         case RenderFormat::R16_UINT:
         case RenderFormat::R16_SNORM:
         case RenderFormat::R16_SINT:
+        case RenderFormat::B5G6R5_UNORM:
         case RenderFormat::R8_TYPELESS:
         case RenderFormat::R8_UNORM:
         case RenderFormat::R8_UINT:
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index 2c3735e..abb2dcd 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -152,6 +152,8 @@ namespace plume {
             return VK_FORMAT_R8G8B8A8_SINT;
         case RenderFormat::R10G10B10A2_UNORM:
             return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+        case RenderFormat::B5G6R5_UNORM:
+            return VK_FORMAT_R5G6B5_UNORM_PACK16;
         case RenderFormat::B8G8R8A8_UNORM:
             return VK_FORMAT_B8G8R8A8_UNORM;
         case RenderFormat::R16G16_TYPELESS:
-- 
2.56.0

