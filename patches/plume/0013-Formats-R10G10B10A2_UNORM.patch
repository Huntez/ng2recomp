From 9959c2e376da6cc66b63a7bf94778ca62ad6cb56 Mon Sep 17 00:00:00 2001
From: cerroverb <84094990+cerroverb@users.noreply.github.com>
Date: Sat, 7 Nov 2026 13:03:31 -0500
Subject: [PATCH] Formats: R10G10B10A2_UNORM

The guest's 2_10_10_10 textures, as Xenia hosts them
(VK_FORMAT_A2B10G10R10_UNORM_PACK32, DXGI_FORMAT_R10G10B10A2_UNORM). Last in
the enum, so the other formats keep their values.
---
 plume_d3d12.cpp                | 2 ++
 plume_render_interface_types.h | 3 +++
 plume_vulkan.cpp               | 2 ++
 3 files changed, 7 insertions(+)

diff --git a/plume_d3d12.cpp b/plume_d3d12.cpp
index 1a0844a..d4ea203 100644
--- a/plume_d3d12.cpp
+++ b/plume_d3d12.cpp
@@ -118,6 +118,8 @@ namespace plume {
             return DXGI_FORMAT_R8G8B8A8_SNORM;
         case RenderFormat::R8G8B8A8_SINT:
             return DXGI_FORMAT_R8G8B8A8_SINT;
+        case RenderFormat::R10G10B10A2_UNORM:
+            return DXGI_FORMAT_R10G10B10A2_UNORM;
         case RenderFormat::B8G8R8A8_UNORM:
             return DXGI_FORMAT_B8G8R8A8_UNORM;
         case RenderFormat::R16G16_TYPELESS:
diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index 95a2c39..baec343 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -177,6 +177,7 @@ namespace plume {
         BC7_TYPELESS,
         BC7_UNORM,
         BC7_UNORM_SRGB,
+        R10G10B10A2_UNORM,
         MAX
     };
 
@@ -566,6 +567,7 @@ namespace plume {
         case RenderFormat::R8G8B8A8_SNORM:
         case RenderFormat::R8G8B8A8_SINT:
         case RenderFormat::B8G8R8A8_UNORM:
+        case RenderFormat::R10G10B10A2_UNORM:
         case RenderFormat::R16G16_TYPELESS:
         case RenderFormat::R16G16_FLOAT:
         case RenderFormat::R16G16_UNORM:
@@ -649,6 +651,7 @@ namespace plume {
         case RenderFormat::R8G8B8A8_SNORM:
         case RenderFormat::R8G8B8A8_SINT:
         case RenderFormat::B8G8R8A8_UNORM:
+        case RenderFormat::R10G10B10A2_UNORM:
         case RenderFormat::R16G16_TYPELESS:
         case RenderFormat::R16G16_FLOAT:
         case RenderFormat::R16G16_UNORM:
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index a91ec76..c1f8efb 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -150,6 +150,8 @@ namespace plume {
             return VK_FORMAT_R8G8B8A8_SNORM;
         case RenderFormat::R8G8B8A8_SINT:
             return VK_FORMAT_R8G8B8A8_SINT;
+        case RenderFormat::R10G10B10A2_UNORM:
+            return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
         case RenderFormat::B8G8R8A8_UNORM:
             return VK_FORMAT_B8G8R8A8_UNORM;
         case RenderFormat::R16G16_TYPELESS:
-- 
