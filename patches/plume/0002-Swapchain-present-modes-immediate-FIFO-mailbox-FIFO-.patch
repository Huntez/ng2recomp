From 154bc94827739b8e6e579c158eb58645ff94571b Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Thu, 29 Oct 2026 22:48:20 +0000
Subject: [PATCH] Swapchain present modes: immediate, FIFO, mailbox, FIFO
 relaxed

setPresentMode() asks for a mode on the next resize, as setVsyncEnabled()
does, and reports whether the surface has it (else FIFO). The Vulkan
backend keeps the surface's supported modes; the others keep the vsync
on/off behaviour.
---
 plume_render_interface.h       |  7 +++++++
 plume_render_interface_types.h |  7 +++++++
 plume_vulkan.cpp               | 24 ++++++++++++++++++++++++
 plume_vulkan.h                 |  2 ++
 4 files changed, 40 insertions(+)

diff --git a/plume_render_interface.h b/plume_render_interface.h
index 1c69c35..70d4c76 100644
--- a/plume_render_interface.h
+++ b/plume_render_interface.h
@@ -93,6 +93,13 @@ namespace plume {
         virtual bool needsResize() const = 0;
         virtual void setVsyncEnabled(bool vsyncEnabled) = 0;
         virtual bool isVsyncEnabled() const = 0;
+
+        // How frames are presented (used from the next resize); false if the backend or
+        // surface lacks the mode, which then falls back to FIFO.
+        virtual bool setPresentMode(RenderPresentMode mode) {
+            setVsyncEnabled(mode != RenderPresentMode::IMMEDIATE);
+            return (mode == RenderPresentMode::IMMEDIATE) || (mode == RenderPresentMode::FIFO);
+        }
         virtual uint32_t getWidth() const = 0;
         virtual uint32_t getHeight() const = 0;
         virtual RenderTexture *getTexture(uint32_t textureIndex) = 0;
diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index cb65524..c6d3d4d 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -94,6 +94,13 @@ namespace plume {
         APPLE = 0x106B,
     };
     
+    enum class RenderPresentMode {
+        IMMEDIATE,
+        FIFO,
+        MAILBOX,
+        FIFO_RELAXED
+    };
+
     enum class RenderFormat {
         UNKNOWN,
         R32G32B32A32_TYPELESS,
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index 5dd4836..a4ddc4c 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -2201,6 +2201,7 @@ namespace plume {
         std::vector<VkPresentModeKHR> presentModes(presentModeCount);
         vkGetPhysicalDeviceSurfacePresentModesKHR(physicalDevice, surface, &presentModeCount, presentModes.data());
         immediatePresentModeSupported = std::find(presentModes.begin(), presentModes.end(), VK_PRESENT_MODE_IMMEDIATE_KHR) != presentModes.end();
+        supportedPresentModes = presentModes;
 
         // Check if the format we requested is part of the supported surface formats.
         std::vector<VkSurfaceFormatKHR> compatibleSurfaceFormats;
@@ -2418,6 +2419,29 @@ namespace plume {
         }
     }
 
+    bool VulkanSwapChain::setPresentMode(RenderPresentMode mode) {
+        VkPresentModeKHR wanted = VK_PRESENT_MODE_FIFO_KHR;
+        switch (mode) {
+        case RenderPresentMode::IMMEDIATE:
+            wanted = VK_PRESENT_MODE_IMMEDIATE_KHR;
+            break;
+        case RenderPresentMode::FIFO:
+            wanted = VK_PRESENT_MODE_FIFO_KHR;
+            break;
+        case RenderPresentMode::MAILBOX:
+            wanted = VK_PRESENT_MODE_MAILBOX_KHR;
+            break;
+        case RenderPresentMode::FIFO_RELAXED:
+            wanted = VK_PRESENT_MODE_FIFO_RELAXED_KHR;
+            break;
+        }
+
+        // Like setVsyncEnabled(), this takes effect on the next resize.
+        bool supported = std::find(supportedPresentModes.begin(), supportedPresentModes.end(), wanted) != supportedPresentModes.end();
+        requiredPresentMode = supported ? wanted : VK_PRESENT_MODE_FIFO_KHR;
+        return supported;
+    }
+
     bool VulkanSwapChain::isVsyncEnabled() const {
         return createdPresentMode == VK_PRESENT_MODE_FIFO_KHR;
     }
diff --git a/plume_vulkan.h b/plume_vulkan.h
index fa4d607..3779bf5 100644
--- a/plume_vulkan.h
+++ b/plume_vulkan.h
@@ -243,6 +243,7 @@ namespace plume {
         std::vector<VulkanTexture> textures;
         uint64_t currentPresentId = 0;
         bool immediatePresentModeSupported = false;
+        std::vector<VkPresentModeKHR> supportedPresentModes;
         uint32_t maxFrameLatency = 0;
 
         VulkanSwapChain(VulkanCommandQueue *commandQueue, RenderWindow renderWindow, uint32_t textureCount, RenderFormat format, uint32_t maxFrameLatency);
@@ -253,6 +254,7 @@ namespace plume {
         bool needsResize() const override;
         void setVsyncEnabled(bool vsyncEnabled) override;
         bool isVsyncEnabled() const override;
+        bool setPresentMode(RenderPresentMode mode) override;
         uint32_t getWidth() const override;
         uint32_t getHeight() const override;
         RenderTexture *getTexture(uint32_t textureIndex) override;
-- 
