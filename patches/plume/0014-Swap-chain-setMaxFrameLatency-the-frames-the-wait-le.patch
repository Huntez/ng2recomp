From bc518b267734ba24ae3eccecbf89bc8d4dcf6135 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sun, 8 Nov 2026 13:18:38 +0000
Subject: [PATCH] Swap chain: setMaxFrameLatency, the frames the wait leaves
 queued

---
 plume_render_interface.h | 2 ++
 plume_vulkan.cpp         | 5 +++++
 plume_vulkan.h           | 1 +
 3 files changed, 8 insertions(+)

diff --git a/plume_render_interface.h b/plume_render_interface.h
index 95c22c1..6921766 100644
--- a/plume_render_interface.h
+++ b/plume_render_interface.h
@@ -92,6 +92,8 @@ namespace plume {
         virtual ~RenderSwapChain() { }
         virtual bool present(uint32_t textureIndex, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount) = 0;
         virtual void wait() = 0;
+        // Frames the wait leaves queued (1: the last present on screen before the next frame).
+        virtual void setMaxFrameLatency(uint32_t maxFrameLatency) { }
         // VK_KHR_present_wait from another thread: the ID of the last present
         // (0 without the extension), and whether that one is on screen yet:
         // 1 yes, 0 not yet, -1 never (an earlier swapchain's, or an error).
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index c1f8efb..c4f43e8 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -2443,6 +2443,11 @@ namespace plume {
         }
     }
 
+    void VulkanSwapChain::setMaxFrameLatency(uint32_t maxFrameLatency) {
+        const std::scoped_lock lock(vkMutex);
+        this->maxFrameLatency = std::max(1u, maxFrameLatency);
+    }
+
     bool VulkanSwapChain::resize() {
         const std::scoped_lock lock(vkMutex);
         getWindowSize(width, height);
diff --git a/plume_vulkan.h b/plume_vulkan.h
index 18aa905..2aa9163 100644
--- a/plume_vulkan.h
+++ b/plume_vulkan.h
@@ -254,6 +254,7 @@ namespace plume {
         ~VulkanSwapChain() override;
         bool present(uint32_t textureIndex, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount) override;
         void wait() override;
+        void setMaxFrameLatency(uint32_t maxFrameLatency) override;
         uint64_t getPresentId() const override;
         int pollPresent(uint64_t presentId) override;
         bool resize() override;
-- 
2.56.0

