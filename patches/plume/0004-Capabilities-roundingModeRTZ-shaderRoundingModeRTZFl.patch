From d2fd55da9a5914d2c78b7b1ea15a025db82dc205 Mon Sep 17 00:00:00 2001
From: gambuzino24 <gambuzino24@gmail.com>
Date: Sat, 31 Oct 2026 17:53:20 +0000
Subject: [PATCH] Capabilities: roundingModeRTZ (shaderRoundingModeRTZFloat32)

---
 plume_render_interface_types.h | 3 +++
 plume_vulkan.cpp               | 9 +++++++++
 2 files changed, 12 insertions(+)

diff --git a/plume_render_interface_types.h b/plume_render_interface_types.h
index c6d3d4d..fd5a014 100644
--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -1925,6 +1925,9 @@ namespace plume {
 
         // Query Pools.
         bool queryPools = false;
+
+        // Shaders may round 32-bit float math toward zero (SPIR-V RoundingModeRTZ).
+        bool roundingModeRTZ = false;
     };
 
     struct RenderInterfaceCapabilities {
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index 4983e65..84481db 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -4152,6 +4152,15 @@ namespace plume {
         capabilities.preferHDR = memoryHeapSize > (512 * 1024 * 1024);
         capabilities.dynamicDepthBias = true;
         capabilities.queryPools = true;
+        {
+            VkPhysicalDeviceFloatControlsProperties floatControls = {};
+            floatControls.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FLOAT_CONTROLS_PROPERTIES;
+            VkPhysicalDeviceProperties2 deviceProperties2 = {};
+            deviceProperties2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+            deviceProperties2.pNext = &floatControls;
+            vkGetPhysicalDeviceProperties2(physicalDevice, &deviceProperties2);
+            capabilities.roundingModeRTZ = (physicalDeviceProperties.apiVersion >= VK_API_VERSION_1_2) && floatControls.shaderRoundingModeRTZFloat32;
+        }
         capabilities.uma = (description.type == RenderDeviceType::INTEGRATED) && hasHostVisibleDeviceLocalMemory;
         capabilities.gpuUploadHeap = capabilities.uma;
 
-- 
