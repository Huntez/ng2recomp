#!/usr/bin/env bash
# Ninja Gaiden II launcher: game files, writable settings/logs/saves, then
# the game. Extra arguments go to the game (ReXGlue options).
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/ng2-recomp
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/ng2-recomp
mkdir -p "$config_dir" "$data_dir/user"

error() {
  if command -v kdialog >/dev/null; then kdialog --title "Ninja Gaiden II" --error "$1"
  else echo "$1" >&2; fi
  exit 1
}

# The game files: NG2_GAME_DIR, the remembered folder, or ask (the extracted
# folder, or the disc image, which is extracted into the data folder).
game=${NG2_GAME_DIR:-}
if [ -z "$game" ] && [ -f "$config_dir/game_dir" ]; then
  game=$(cat "$config_dir/game_dir")
fi
if [ -z "$game" ] || [ ! -f "$game/default.xex" ]; then
  command -v kdialog >/dev/null ||
    error "Set NG2_GAME_DIR to the folder with default.xex (kdialog is needed to ask)."
  choice=$(kdialog --title "Ninja Gaiden II: game files" \
    --getopenfilename "$HOME" "*.iso default.xex|Disc image or default.xex") || exit 0
  case "$choice" in
    *.iso|*.ISO)
      game=$data_dir/game
      rm -rf "$game.part"
      python3 -I "$here/usr/bin/xdvdfs_extract.py" "$choice" "$game.part" ||
        error "Could not read the disc image."
      rm -rf "$game" && mv "$game.part" "$game"
      ;;
    *) game=$(dirname "$choice") ;;
  esac
  [ -f "$game/default.xex" ] || error "No default.xex in $game."
  printf '%s\n' "$game" > "$config_dir/game_dir"
fi

export NG2_RENDERER=${NG2_RENDERER:-native}
export NG2_CONFIG=${NG2_CONFIG:-$config_dir/ng2.toml}
exec "$here/usr/bin/ng2" --game_data_root="$game" --user_data_root="$data_dir/user" \
  --log_file="$data_dir/ng2.log" "$@"
